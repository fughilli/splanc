{
  "title": "CI Failures",
  "uid": "ci-failures",
  "tags": ["ci", "splanc", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "runner",
        "label": "Runner/DUT",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "label_values({job=\"ci-results\"}, runner)",
        "query": {
          "label": "runner",
          "stream": "{job=\"ci-results\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "label_values({job=\"ci-results\"}, workflow)",
        "query": {
          "label": "workflow",
          "stream": "{job=\"ci-results\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failures (range)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flaky (range)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", result=\"flaky\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Passed (range)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", result=\"pass\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total results (range)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Results over time",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "fail"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"ci-results\", result=\"flaky\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "flaky"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Failures aggregated by trace / reason",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Failures by signature (trace)",
      "description": "Distinct failure signatures, most frequent first. Matches the issue's \"Failure: out of disk\" vs \"ValueError: divide by zero\" view.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlRd"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "displayName",
                "value": "count"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "failure_signature": 0,
              "failure_category": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (failure_signature, failure_category) (count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} | json [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Failures by category",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (failure_category) (count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{failure_category}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Failures by runner / DUT",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Failures by runner/DUT",
      "description": "Compare hitl vs github:linux vs github:macos (etc.) to spot flaky hardware/runner configs.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (runner) (count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{runner}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Failure rate by runner over time",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (runner) (count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} [$__auto]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{runner}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Heatmap of failures by test case",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Failures by test case",
      "description": "Per-test-case failure counts (color-graded). The most-failing cases bubble to the top \u2014 the heatmap of flaky/broken tests.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlRd"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "displayName",
                "value": "failures"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "target": 0,
              "test_case": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "failures",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (target, test_case) (count_over_time({job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} | json | test_case!=\"\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 32,
      "type": "logs",
      "title": "Recent failures (drill-down)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 35
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"ci-results\", result=\"fail\", runner=~\"$runner\", workflow=~\"$workflow\"} | json | line_format \"{{.runner}} {{.target}} {{.test_case}} \u2014 {{.failure_category}}: {{.failure_reason}}\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    }
  ]
}
