# Bazel configuration for the LED Mapper polyglot repo (Python on Pi, TS on web).
# Pinned versions of toolchains are recorded in docs/decisions.md.

# Workaround: Bazel 7.7.1's bundled JDK 21 emits SVE instructions in its
# startup stubs that crash with SIGILL on some aarch64 hosts (notably this
# dev container after an image rebuild). Disabling SVE codegen is harmless on
# hosts without SVE. See docs/decisions.md.
startup --host_jvm_args=-XX:UseSVE=0

# bzlmod is the source of truth — no WORKSPACE.
common --enable_bzlmod
common --registry=https://bcr.bazel.build

# Make actions hermetic so caching is correct across machines.
build --incompatible_strict_action_env

# Persist a build cache in the project tree (gitignored, dot-prefixed) so it
# survives container restarts and fresh --output_base wipes.
build --disk_cache=.bazel-disk-cache

# Reasonable test ergonomics: only show output for failing tests.
test --test_output=errors

# Avoid Bazel's default "//..." also descending into bazel-* symlinks.
build --symlink_prefix=bazel-

# Quieter status — agents and CI don't need a curses progress bar.
common --color=yes
common --show_timestamps
