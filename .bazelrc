# Bazel configuration for the LED Mapper polyglot repo (Python on Pi, TS on web).
# Pinned versions of toolchains are recorded in docs/decisions.md.

# Workaround: Bazel 7.7.1's bundled JDK 21 emits SVE instructions in its
# startup stubs that crash with SIGILL on some aarch64 hosts (notably this
# dev container after an image rebuild). Disabling SVE codegen is harmless on
# hosts without SVE. See docs/decisions.md.
# IgnoreUnrecognizedVMOptions first: UseSVE only exists on aarch64 JVMs, and
# an unguarded unknown flag would abort Bazel's server JVM on x86_64 (CI).
startup --host_jvm_args=-XX:+IgnoreUnrecognizedVMOptions
startup --host_jvm_args=-XX:UseSVE=0

# bzlmod is the source of truth — no WORKSPACE.
common --enable_bzlmod
common --registry=https://bcr.bazel.build

# Make actions hermetic so caching is correct across machines.
build --incompatible_strict_action_env

# Persist Bazel state in the project tree (gitignored, dot-prefixed) so it
# survives container restarts, which wipe the container's root fs (~/.cache).
# Both caches are content-addressable (hash filenames), so they are safe on the
# case-insensitive macOS bind mount — unlike a full output base, whose Python
# repo tree has files differing only by case and corrupts there.
#   - disk cache: action outputs (skips recompile).
#   - repository cache: downloaded external archives (skips the slow, flaky
#     network re-fetch — the real first-build bottleneck).
build --disk_cache=.bazel-disk-cache
common --repository_cache=.bazel-repo-cache

# Reasonable test ergonomics: only show output for failing tests.
test --test_output=errors

# Avoid Bazel's default "//..." also descending into bazel-* symlinks.
build --symlink_prefix=bazel-

# Quieter status — agents and CI don't need a curses progress bar.
common --color=yes
common --show_timestamps

# Vite/rolldown breaks under the sandbox: it realpath()s entry files through
# the sandbox's input symlinks while the project root stays at the sandbox
# path, so emitted HTML asset names become ../../-escaping paths. Run the
# (fully input/output-declared) Vite action unsandboxed instead. Applying the
# strategy by mnemonic here avoids tagging the target, which would propagate
# execution requirements into shared copy-to-bin actions and cause action
# conflicts with the ts_project targets over the same sources.
build --strategy=Vite=local

# The vendored firmware module (third_party/embedded) uses ISOLATED
# rules_nixpkgs extension usages (its nix attr/file tags are otherwise
# root-module-only); isolation is experimental in Bazel 7.
common --experimental_isolated_extension_usages

# --- memory caps (small dev containers OOM the JVM + heavy C++ compiles) ---
# hitl memory caps
startup --host_jvm_args=-Xmx1500m
build --local_ram_resources=2048
build --jobs=3

# CI runs on beefy hosts (GitHub ubuntu-latest: 4 vCPU / 16 GB), so the
# small-container caps above just throttle it — a 3-wide, ~2 GB build starves
# the heavy firmware compile (mbedtls + Arduino core) of the runner's cores and
# RAM. `--config=ci` restores Bazel's defaults (schedule against the real host
# CPUs/RAM); harmless on a 16 GB runner, and it's how the CI workflows invoke
# every heavy bazel build/test/run.
build:ci --jobs=HOST_CPUS
build:ci --local_ram_resources=HOST_RAM
