"""web — M5 (xr), M6 (cv), M7 (net), M8 (ui) + the virtual LED wall test page.

Two entry pages (Vite): `/` the phone capture app, `/wall.html` the laptop
virtual-LED-wall fixture. `@ledmapper/protocol` (M10) comes in through the
pnpm workspace link.

Targets:
  :web_ts_typecheck_test   type-checks the app sources (auto from no_emit)
  :unit_tests              node:test suites for the pure-TS core (gray code,
                           timing, clock sync, M7 client, tracker, decoder,
                           and the synthetic Phase-3-style pipeline test)
  :dist                    production bundle (vite build)
  :serve                   M2 server + built web app, HTTPS by default
                           (bazelisk run //web:serve)
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//web:vite/package_json.bzl", vite_bin = "bin")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The cross-language goldens (Python-generated, TS-verified here) also feed
# the firmware legs: the wire frames drive the Rust/micropb conformance test
# (//shared/protocol/rust) and the player protocol test (//firmware/player);
# the pattern goldens pin the firmware hue-code generator
# (//firmware/pattern) to what the phone decoder is tested against.
exports_files([
    "tests/golden_proto_frames.json",
    "tests/golden_secded16.json",
    "tests/golden_secded16_sym4.json",
    # The unified FX-bench golden: the web estimator test imports it, and the HITL
    # //pi/hitl/harness:fx_bench margin check cross-deps it (one source of truth).
    "tests/testdata/device-bench-esp32c6.json",
])

npm_link_all_packages(name = "node_modules")

SRCS = glob(["src/**/*.ts"])

# Non-TS assets imported for their side effects by the app bundle (the design
# tokens + app-shell stylesheet). tsc ignores these (they resolve via the
# `*.css` module declaration in src/env.d.ts); Vite needs the real files.
CSS = glob(["src/**/*.css"])

TYPE_DEPS = [
    ":node_modules/@bufbuild/protobuf",
    ":node_modules/@ledmapper/protocol",
    ":node_modules/@types/node",
    ":node_modules/@types/w3c-web-serial",
    ":node_modules/@types/w3c-web-usb",
    ":node_modules/@types/webxr",
    # esptool-js drives the in-browser USB flasher (FUG-60); @types/w3c-web-serial
    # supplies the Web Serial globals both it and our flash/ code use.
    ":node_modules/esptool-js",
    # web-serial-polyfill (FUG-85): a Web Serial implementation over WebUSB, so
    # the flasher works on Android Chrome (which has WebUSB but not Web Serial).
    # @types/w3c-web-usb types the WebUSB globals the polyfill's .d.ts references.
    ":node_modules/web-serial-polyfill",
]

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_config(
    name = "tsconfig_test",
    src = "tsconfig.test.json",
    deps = ["//:tsconfig_base"],
)

# Type-check-only for the app + vite config; the bundler does the transpiling.
# no_emit generates :web_ts_typecheck_test.
ts_project(
    name = "web_ts",
    srcs = SRCS + ["vite.config.ts"],
    no_emit = True,
    resolve_json_module = True,
    tsconfig = ":tsconfig",
    deps = TYPE_DEPS + [":node_modules/vite"],
)

# Unit-test build: src + tests compiled to CommonJS that Node runs directly
# (see tsconfig.test.json for why CJS). Emitted under dist-test/ so the
# imported golden *.json fixtures can be emitted too (same-path would be a
# tsc input/output collision).
ts_project(
    name = "web_tests_js",
    # src/solver/spawn.ts is browser-only (import.meta worker URL — a syntax
    # error under this CJS compile) and only ever loaded lazily; see its
    # docstring.
    srcs = glob(
        [
            "src/**/*.ts",
            "tests/**/*.ts",
            "tests/**/*.json",
        ],
        exclude = [
            "src/solver/spawn.ts",
            # Browser-only: import.meta worker URL / `self` — syntax-invalid or
            # meaningless under the CJS test compile (see their docstrings). The
            # the in-shell effect editor statically imports the worker client
            # (import.meta), so it's excluded — as is the page-entry chain that
            # imports it (main → app/main → effectEditor). These are browser-only
            # bundle entries, never required by a unit test.
            "src/effects/editor/compiler.ts",
            "src/effects/editor/compile-worker.ts",
            "src/ui/screens/effectEditor.ts",
            # Acid mode (FUG-106) also statically imports the worker compiler, so
            # it's a browser-only bundle entry too (reached only via app/main).
            "src/ui/screens/acidMode.ts",
            "src/ui/app/main.ts",
            "src/ui/main.ts",
        ],
    ),
    declaration = False,
    out_dir = "dist-test",
    resolve_json_module = True,
    source_map = False,
    transpiler = "tsc",
    tsconfig = ":tsconfig_test",
    deps = TYPE_DEPS,
)

# One js_test per tests/*.test.ts file, running the emitted CJS under
# node:test (registering tests at require-time sets the exit code).
[
    js_test(
        name = f.removeprefix("tests/").removesuffix(".test.ts") + "_test",
        data = [":web_tests_js"],
        entry_point = ":dist-test/" + f.removesuffix(".ts") + ".js",
    )
    for f in glob(["tests/*.test.ts"])
]

test_suite(
    name = "unit_tests",
    tests = [
        f.removeprefix("tests/").removesuffix(".test.ts") + "_test"
        for f in glob(["tests/*.test.ts"])
    ],
)

# The emitted dist-test tree is CommonJS, but web/package.json declares
# "type": "module" — this nearer package.json rescopes dist-test/*.js back to
# CJS for plain `node` execution (js_binary; the js_test runner tolerates it
# either way).
genrule(
    name = "dist_test_pkg_json",
    outs = ["dist-test/package.json"],
    cmd = "echo '{\"type\": \"commonjs\"}' > $@",
)

# Offline decode of a ?record=1 trace through the CANONICAL M6
# tracker/decoder (VIO exploration phase 3, docs/vio-exploration.md):
#   bazelisk run //web:offline_decode -- <frames.jsonl> <out.json>
js_binary(
    name = "offline_decode",
    data = [
        ":dist_test_pkg_json",
        ":web_tests_js",
    ],
    entry_point = ":dist-test/tests/tools/offlineDecode.js",
)

# Headless fit + validation of a HITL device-measurement bundle (FUG-11) through
# the same buildDeviceProfile the app uses — so a rig run can fit + validate +
# commit an authoritative device profile with no browser:
#   bazelisk run //web:fit_device_profile -- <bundle.json> [out-profile.json]
js_binary(
    name = "fit_device_profile",
    data = [
        ":dist_test_pkg_json",
        ":web_tests_js",
    ],
    entry_point = ":dist-test/tests/tools/fitDeviceProfile.js",
)

# Auto-generate docs/fx-vm-performance.md from the golden HITL benchmark bundles
# (FUG-95), reusing the same buildDeviceProfile + validateCostModel cost model
# the app and the hardware-validation test use. Regenerate the checked-in doc:
#   bazel run //web:gen_fx_vm_perf_doc
# (writes into the source tree via $BUILD_WORKSPACE_DIRECTORY). The freshness
# genrule below runs it with --check under `bazel test //...`.
js_binary(
    name = "gen_fx_vm_perf_doc",
    data = [
        ":dist_test_pkg_json",
        ":web_tests_js",
    ],
    entry_point = ":dist-test/tests/tools/genFxVmPerfDoc.js",
)

# The golden HITL benchmark bundles the perf doc is generated from (one per
# platform; only esp32c6 today). A filegroup so the freshness genrule can pass
# every bundle to the generator regardless of how many platforms exist.
filegroup(
    name = "device_bench_goldens",
    srcs = glob(["tests/testdata/device-bench-*.json"]),
)

# Freshness gate mirroring //shared/protocol:codegen_freshness: regenerate the
# perf doc in memory and diff it against the checked-in copy, failing the build
# if a VM/cost-model/golden change moved the numbers without a re-pin. `bazel
# test //...` (and CI) builds this, so the doc can't silently drift.
genrule(
    name = "fx_vm_perf_doc_freshness",
    srcs = [
        ":device_bench_goldens",
        "//:docs/fx-vm-performance.md",
    ],
    outs = ["fx_vm_perf_doc_freshness.stamp"],
    # BAZEL_BINDIR=. lets the aspect_rules_js js_binary launcher run out of the
    # execroot root inside this build action (it otherwise refuses); see the
    # rules_js note the launcher prints without it.
    cmd = "BAZEL_BINDIR=. $(execpath :gen_fx_vm_perf_doc) --check " +
          "--out $(location //:docs/fx-vm-performance.md) " +
          "$(locations :device_bench_goldens) && touch $@",
    tools = [":gen_fx_vm_perf_doc"],
)

# Production bundle. vite resolves the config's own `import "vite"` and the
# workspace protocol package through the linked node_modules. NOTE: the Vite
# action runs unsandboxed via `--strategy=Vite=local` in .bazelrc — see the
# comment there (rolldown vs sandbox symlinks).
vite_bin.vite(
    name = "dist",
    srcs = SRCS + CSS + glob(["public/**"]) + [
        "effects.html",
        "index.html",
        "package.json",
        "vite.config.ts",
        "wall.html",
        ":node_modules/@bufbuild/protobuf",
        ":node_modules/@ledmapper/protocol",
        ":node_modules/esptool-js",
        ":node_modules/vite",
        ":node_modules/web-serial-polyfill",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

# One-command phone-testing entry point: M2 server serving the built app.
# HTTPS by default (WebXR needs a secure context); state (self-signed cert,
# session logs, maps) persists under <workspace>/.ledmapper/.
#   bazelisk run //web:serve                    # https://0.0.0.0:8443
#   bazelisk run //web:serve -- --no-tls        # http://0.0.0.0:8080 (wall/dev)
#   bazelisk run //web:serve -- --port 9000 ... # extra args go to the server
sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":dist",
        "//firmware/fx_vm:fx_vm_web",
        "//firmware/pulse:pulse_web",
        "//fx_compiler:fx_compiler_web",
        "//pi/server:serve",
        "//solver:solver_web",
    ],
)

# The complete publish tree (app bundle + the four wasm bundles) and its data
# deps, shared by the Cloudflare and GitHub Pages publishers below. The staging
# layout itself lives in stage_site.lib.sh (sourced by both), so every origin
# serves a byte-identical tree.
SITE_DATA = [
    ":dist",
    "stage_site.lib.sh",
    "//firmware/fx_vm:fx_vm_web",
    "//firmware/pulse:pulse_web",
    "//fx_compiler:fx_compiler_web",
    "//solver:solver_web",
    # The staging tool that lays the firmware image(s) under /firmware/ for
    # in-browser USB flashing (FUG-60). The flash bundle itself is NOT a data dep
    # here — building it compiles the esp32c6 image (mbedtls + Arduino core from
    # source, minutes) and is kept out of routine site builds. stage_site.lib.sh
    # stages firmware only when handed a prebuilt bundle via $LEDMAPPER_FLASHBUNDLE
    # (CI's firmware job builds it and passes it to build-site); otherwise the app
    # simply reports no bundled firmware.
    "//tools:stage_firmware",
]

# Publish the static artifacts (app bundle + wasm solver) to Cloudflare
# Pages — the externally-hosted webapp the ESP32 player points phones at.
# Deploys need CLOUDFLARE_API_TOKEN; `-- --dry-run` stages and prints only.
sh_binary(
    name = "deploy_cloudflare",
    srcs = ["deploy_cloudflare.sh"],
    data = SITE_DATA,
)

# Materialize the same publish tree into a directory for the GitHub Pages CI:
#   bazel run //web:stage_site -- <output-dir>
# The master-merge job publishes it to the Pages root; the PR job publishes it
# under pr-preview/pr-N/ (see the deploy jobs in .github/workflows/test.yaml).
sh_binary(
    name = "stage_site",
    srcs = ["stage_site.sh"],
    data = SITE_DATA,
)
