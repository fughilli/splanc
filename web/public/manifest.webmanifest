{
  "name": "LED Mapper",
  "short_name": "LED Mapper",
  "description": "Map, control, and animate addressable LED fixtures from your phone.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
