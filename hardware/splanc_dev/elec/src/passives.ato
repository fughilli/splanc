# Thin two-terminal wrappers over the committed atomic LCSC passives, each
# exposing p1/p2. Using the pre-picked atomic parts directly (rather than stdlib
# Resistor/Capacitor + lcsc_id) keeps the build hermetic: stdlib picks re-query
# the components API + EasyEDA on every build, whereas these carry a
# has_part_picked trait and need no network. See hardware/README.md.

from "parts/Samsung_CL05B104KO5NNNC/Samsung_CL05B104KO5NNNC.ato" import Samsung_CL05B104KO5NNNC_package
from "parts/Samsung_CL05A105KA5NQNC/Samsung_CL05A105KA5NQNC.ato" import Samsung_CL05A105KA5NQNC_package
from "parts/Samsung_CL10A106KP8NNNC/Samsung_CL10A106KP8NNNC.ato" import Samsung_CL10A106KP8NNNC_package
from "parts/Samsung_CL21A106KAYNNNE/Samsung_CL21A106KAYNNNE.ato" import Samsung_CL21A106KAYNNNE_package
from "parts/Samsung_CL21A226MOQNNNE/Samsung_CL21A226MOQNNNE.ato" import Samsung_CL21A226MOQNNNE_package
from "parts/Sunlord_GZ2012D601TF/Sunlord_GZ2012D601TF.ato" import Sunlord_GZ2012D601TF_package
from "parts/Sunlord_SWPA6045S1R0NT/Sunlord_SWPA6045S1R0NT.ato" import Sunlord_SWPA6045S1R0NT_package
from "parts/UNI_ROYAL_0402WGF0000TCE/UNI_ROYAL_0402WGF0000TCE.ato" import UNI_ROYAL_0402WGF0000TCE_package
from "parts/UNI_ROYAL_0402WGF330JTCE/UNI_ROYAL_0402WGF330JTCE.ato" import UNI_ROYAL_0402WGF330JTCE_package
from "parts/UNI_ROYAL_0402WGF1500TCE/UNI_ROYAL_0402WGF1500TCE.ato" import UNI_ROYAL_0402WGF1500TCE_package
from "parts/UNI_ROYAL_0402WGF1001TCE/UNI_ROYAL_0402WGF1001TCE.ato" import UNI_ROYAL_0402WGF1001TCE_package
from "parts/UNI_ROYAL_0402WGF2001TCE/UNI_ROYAL_0402WGF2001TCE.ato" import UNI_ROYAL_0402WGF2001TCE_package
from "parts/UNI_ROYAL_0402WGF5101TCE/UNI_ROYAL_0402WGF5101TCE.ato" import UNI_ROYAL_0402WGF5101TCE_package
from "parts/UNI_ROYAL_0603WAF1002T5E/UNI_ROYAL_0603WAF1002T5E.ato" import UNI_ROYAL_0603WAF1002T5E_package
from "parts/UNI_ROYAL_0402WGF1003TCE/UNI_ROYAL_0402WGF1003TCE.ato" import UNI_ROYAL_0402WGF1003TCE_package

# -- Capacitors --------------------------------------------------------------
module C100n:
    """100 nF 0402 (C1525)."""
    _p = new Samsung_CL05B104KO5NNNC_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

module C1u:
    """1 uF 0402 (C52923)."""
    _p = new Samsung_CL05A105KA5NQNC_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

module C10u_0603:
    """10 uF 0603 (C19702)."""
    _p = new Samsung_CL10A106KP8NNNC_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

module C10u:
    """10 uF 0805 (C15850)."""
    _p = new Samsung_CL21A106KAYNNNE_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

module C22u:
    """22 uF 0805 (C98190)."""
    _p = new Samsung_CL21A226MOQNNNE_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

# -- Inductor / ferrite ------------------------------------------------------
module L1u:
    """1 uH power inductor 6x6 (C96955)."""
    _p = new Sunlord_SWPA6045S1R0NT_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

module FB600:
    """600R@100MHz ferrite bead 0805 (C1017)."""
    _p = new Sunlord_GZ2012D601TF_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2

