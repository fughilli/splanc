module Rshunt:
    """LED-channel current-sense shunt — 0 ohm 0402 STAND-IN.

    Production BOM substitutes a 10 mOhm 2512 shunt (e.g. Uniroyal RLP25FEGMR010,
    LCSC C393072): swap _p for that 2512 atomic part once its EasyEDA footprint
    generates cleanly (it hit a picker error in this environment). The INA226
    measures across p1/p2 either way, so the schematic is correct; only the shunt
    footprint + value change. See docs/hardware/splanc-dev-module.md §6."""
    _p = new UNI_ROYAL_0402WGF0000TCE_package
    signal p1 ~ _p.p1
    signal p2 ~ _p.p2
