"""Algorithmic place-and-route for the atopile PCBs (FUG-138).

Design + rationale: docs/hardware/pnr-system.md. Running handoff: WORKLOG.md.
This package is the CPU-first Python engine; the differentiable placement core
(a later phase) is PyTorch. The two interpreters in the flow are kept apart:

- `pnr` (this py_library) is imported by the hermetic rules_python interpreter
  that carries torch. `pnr.ingest`/`pnr.writeback` import KiCad's `pcbnew`
  **lazily**, so the library imports fine here even though `pcbnew` is absent —
  the `pcbnew` path runs out-of-band under `@kicad_python`, wired by the
  `atopile_pnr` rule in `//hardware/pnr:pnr.bzl` (the `<board>.fab` flow).
- `torch_smoke_test` is the Task 0 gate: torch imports + runs on CPU.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The stdlib-only pnr sources the pcbnew steps (ingest, writeback) run under
# @kicad_python — staged as plain files on PYTHONPATH, NOT the torch py_library
# (KiCad's python has no torch and doesn't need it). See //hardware/pnr:pnr.bzl.
filegroup(
    name = "pnr_kicad_srcs",
    srcs = [
        "pnr/__init__.py",
        "pnr/graph.py",
        "pnr/ingest.py",
        "pnr/planes.py",
        "pnr/quality.py",
        "pnr/writeback.py",
    ],
)

# Core: graph + constraints + ingest. No torch/numpy — the light path that the
# KiCad pcbnew flow and the schema tests use.
py_library(
    name = "pnr",
    srcs = glob(["pnr/*.py"]),  # top-level modules only, not pnr/place/
    imports = ["."],
    deps = [
        requirement("pyyaml"),  # constraints.py parses the sidecar YAML
    ],
)

# Placement engine (Phase 2): differentiable global placement (torch) + grid
# legalization (numpy). Separated so the core/schema tests stay torch-free.
py_library(
    name = "pnr_place",
    srcs = glob(
        ["pnr/place/*.py"],
        exclude = ["pnr/place/__main__.py"],
    ),
    imports = ["."],
    deps = [
        ":pnr",
        requirement("torch"),
        requirement("numpy"),
    ],
)

# Runnable placer: python -m pnr.place graph.json constraints.yaml [--dump-svg ...]
py_binary(
    name = "place",
    srcs = ["pnr/place/__main__.py"],
    imports = ["."],
    main = "pnr/place/__main__.py",
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("pyyaml"),
    ],
)

# Lookahead global router + place<->route feedback loop (Phase 4). Pure
# python/numpy (no torch of its own) but the feedback loop calls the torch
# placer, so it depends on :pnr_place.
py_library(
    name = "pnr_route",
    srcs = glob(
        ["pnr/route/*.py"],
        exclude = ["pnr/route/__main__.py"],
    ),
    imports = ["."],
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("numpy"),
    ],
)

# Own detailed router (design §Detailed router, R2–R5): grid/obstacle model + a
# multi-layer PathFinder maze router. Pure python/numpy; imports place.geometry
# (torch-containing package, but the router logic is torch-free).
py_library(
    name = "pnr_detail",
    srcs = glob(["pnr/route/detail/*.py"]),
    imports = ["."],
    deps = [
        ":pnr",
        ":pnr_place",
        requirement("numpy"),
    ],
)

# Runnable end-to-end place+route loop: emits the final placed graph JSON that
# the writeback step turns back into a .kicad_pcb. This is the torch-side step
# of the <board>.fab flow.
py_binary(
    name = "pnr_fab",
    srcs = ["pnr/route/__main__.py"],
    imports = ["."],
    main = "pnr/route/__main__.py",
    visibility = ["//visibility:public"],
    deps = [
        ":pnr",
        ":pnr_place",
        ":pnr_route",
        requirement("pyyaml"),
    ],
)

