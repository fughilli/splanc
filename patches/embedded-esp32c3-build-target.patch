+# --- esp32c3 variants of the bundled Arduino libraries (build-only) --------
+# Parallel to the c6 network/fs/wifi/hash/ble/preferences/webserver libs, but
+# built against sdk_hdrs_esp32c3 so a c3 image carries ONE (c3) IDF include set
+# instead of c6+c3 (which overflowed the g++->cc1plus argv). Same board-agnostic
+# library sources; only the SDK header/define carrier differs.
+
+cc_library(
+    name = "network_esp32c3",
+    srcs = glob(["libraries/Network/src/**/*.cpp"], allow_empty = True),
+    hdrs = glob(["libraries/Network/src/**/*.h"], allow_empty = True),
+    includes = ["libraries/Network/src"],
+    copts = _CXX_COPTS_ESP32C3,
+    deps = [":sdk_hdrs_esp32c3"],
