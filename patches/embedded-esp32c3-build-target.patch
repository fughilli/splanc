diff --git a/toolchains/cc/esp32c3/BUILD.bazel b/toolchains/cc/esp32c3/BUILD.bazel
new file mode 100644
index 0000000..0b7f330
--- /dev/null
+++ b/toolchains/cc/esp32c3/BUILD.bazel
@@ -0,0 +1,58 @@
+# ESP32-C3 (RISC-V rv32imc — NO atomics) cc_toolchain: reusable config rule + the
+# Nix Espressif riscv32-esp-elf GCC (@riscv_gcc), gated to //platforms:esp32c3.
+#
+# Mirrors the esp32c6 toolchain, but the C3 core is rv32imC (no 'a'/atomics
+# extension), so the base -march differs. Most compile/link detail (defines,
+# includes, ld scripts, libs) comes from the esp32-arduino-libs `flags/*`
+# response files in nix/arduino_esp32.BUILD; here we set only the arch flags so
+# the right multilib is selected. Build-only target (see //platforms:esp32c3).
+load("//toolchains/cc:cc_toolchain_config.bzl", "cc_toolchain_config")
+
+package(default_visibility = ["//visibility:public"])
+
+_ARCH_FLAGS = [
+    "-march=rv32imc_zicsr_zifencei",
+    "-mabi=ilp32",
+]
+
+cc_toolchain_config(
+    name = "config",
+    toolchain_identifier = "esp32c3-riscv32-esp-elf",
+    target_cpu = "riscv32",
+    target_system_name = "riscv32-esp-elf",
+    gcc = "@riscv_gcc//:gcc",
+    gpp = "@riscv_gcc//:g++",
+    ar = "@riscv_gcc//:ar",
+    strip = "@riscv_gcc//:strip",
+    compile_flags = _ARCH_FLAGS + [
+        "-ffunction-sections",
+        "-fdata-sections",
+        "-no-canonical-prefixes",
+    ],
+    link_flags = _ARCH_FLAGS + [
+        "-no-canonical-prefixes",
+    ],
+)
+
+cc_toolchain(
+    name = "esp32c3_cc",
+    all_files = "@riscv_gcc//:all",
+    ar_files = "@riscv_gcc//:all",
+    compiler_files = "@riscv_gcc//:all",
+    dwp_files = "@riscv_gcc//:all",
+    linker_files = "@riscv_gcc//:all",
+    objcopy_files = "@riscv_gcc//:all",
+    strip_files = "@riscv_gcc//:all",
+    toolchain_config = ":config",
+)
+
+toolchain(
+    name = "cc_toolchain",
+    target_compatible_with = [
+        "@platforms//cpu:riscv32",
+        "@platforms//os:none",
+        "//platforms:esp32c3_board",
+    ],
+    toolchain = ":esp32c3_cc",
+    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
+)
