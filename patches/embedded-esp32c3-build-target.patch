+# ESP32-C3 second-stage bootloader as a flashable .bin. Same QIO-built/DIO-header
+# arrangement as the C6 (both RISC-V ESP parts); the C3 ROM also boots in DIO and
+# the bootloader upgrades to quad I/O itself. Build-only c3 target.
+genrule(
+    name = "esp32c3_bootloader_bin",
+    srcs = ["@arduino_esp32//:bootloader_elf_esp32c3"],
+    outs = ["esp32c3_bootloader.bin"],
+    cmd = ("$(execpath @esptool//:bin) --chip esp32c3 elf2image " +
+           "--flash_mode dio --flash_freq 80m --flash_size 4MB " +
+           "-o $@ $(location @arduino_esp32//:bootloader_elf_esp32c3)"),
+    tools = ["@esptool//:bin", "@esptool//:all"],
+)
+
 # Classic ESP32 (WROOM) second-stage bootloader. Same QIO-built/DIO-header
 # arrangement as the C6; this chip's ROM loads it from 0x1000, not 0x0.
 genrule(
diff --git a/libs/board/esp32c3.cpp b/libs/board/esp32c3.cpp
new file mode 100644
index 0000000..c21f422
--- /dev/null
+++ b/libs/board/esp32c3.cpp
@@ -0,0 +1,13 @@
+// ESP32-C3 board support: drive LED_BUILTIN via the Arduino API (arduino-esp32).
+// Mirrors esp32c6.cpp — the Arduino LED_BUILTIN abstraction is board-agnostic.
+#include <Arduino.h>
+
+#include "libs/board/board.h"
+
+extern "C" void board_setup(void) {
+  pinMode(LED_BUILTIN, OUTPUT);
+}
+
+extern "C" void board_set_led(bool on) {
+  digitalWrite(LED_BUILTIN, on ? HIGH : LOW);
+}
