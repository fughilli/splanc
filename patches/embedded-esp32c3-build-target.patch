+        "sdk/esp32c3/include/freertos/FreeRTOS-Kernel/portable/riscv/include/freertos",
+        "sdk/esp32c3/include/freertos/esp_additions/include",
+        "sdk/esp32c3/include/esp_hw_support/include",
+        "sdk/esp32c3/include/esp_hw_support/include/soc",
+        "sdk/esp32c3/include/esp_hw_support/include/soc/esp32c3",
+        "sdk/esp32c3/include/esp_hw_support/dma/include",
+        "sdk/esp32c3/include/esp_hw_support/ldo/include",
+        "sdk/esp32c3/include/esp_hw_support/debug_probe/include",
+        "sdk/esp32c3/include/esp_hw_support/mspi_timing_tuning/include",
