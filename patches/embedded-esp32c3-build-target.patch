diff --git a/nix/arduino_esp32.BUILD b/nix/arduino_esp32.BUILD
index 51acb0b..4e2d9ad 100644
--- a/nix/arduino_esp32.BUILD
+++ b/nix/arduino_esp32.BUILD
@@ -1,5 +1,6 @@
 # GENERATED scaffold for @arduino_esp32 (merged core + per-chip SDKs: esp32c6
-# RISC-V and classic esp32 Xtensa — the esp32 section is at the bottom).
+# RISC-V, classic esp32 Xtensa, and esp32c3 RISC-V build-only — the esp32 section
+# is in the middle, the esp32c3 section at the bottom).
 # Compile: includes/defines as native attrs (propagate to the app); per-language
 # std flags. Link: -L dirs computed at build time + the shipped ld_* response
 # files, in a --start-group with the SDK archives.
@@ -1119,3 +1120,619 @@ cc_library(
     ],
     deps = [":core_c_esp32", ":core_cpp_esp32", ":sdk_hdrs_esp32"],
 )
+
+
+# ===========================================================================
+# ESP32-C3 (RISC-V rv32imc — NO atomics) — parallel chip-specific targets to
+# the esp32c6 ones above, against sdk/esp32c3/. BUILD-ONLY target: mirrors the
+# C6 recipe (include list, from-source mbedtls + ssl wraps, copts) with the
+# arch dropped to rv32imc and the ESP32C3_DEV board defines. The include list
+# is inherited verbatim from the C6 (non-existent -I dirs are harmless no-ops);
+# the shared partition/gen_esp32part/boot_app0 + Arduino-library (wifi/ble/...)
+# targets are NOT re-declared — they are chip-independent / stay C6-built.
+# TODO(esp32c3): audit the include list + memory-type dir against the real C3
+# SDK once c3 is a runtime target.
+# ===========================================================================
+
+genrule(
+    name = "sdk_link_dirs_esp32c3",
+    srcs = [
+        "sdk/esp32c3/lib/libriscv.a",
+        "sdk/esp32c3/ld/memory.ld",
+        "sdk/esp32c3/qio_qspi/libspi_flash.a",
+    ],
+    outs = ["sdk_link_dirs_esp32c3.rsp"],
+    cmd = ("echo \"-L$$(dirname $(location sdk/esp32c3/lib/libriscv.a))\" > $@ && " +
+           "echo \"-L$$(dirname $(location sdk/esp32c3/ld/memory.ld))\" >> $@ && " +
+           "echo \"-L$$(dirname $(location sdk/esp32c3/qio_qspi/libspi_flash.a))\" >> $@"),
+)
+
+filegroup(name = "sdk_libs_esp32c3", srcs = glob(
+    [
+        "sdk/esp32c3/lib/*.a",
+        "sdk/esp32c3/qio_qspi/*.a",
+        "sdk/esp32c3/ld/*.a",  # libphy.a, libbtbb.a live alongside the ld scripts
+    ],
+    # mbedtls is built FROM SOURCE (@mbedtls_src, with dynamic buffers) and linked
+    # into :core_esp32c3 instead — drop the prebuilt archives so our symbols win.
+    exclude = [
+        "sdk/esp32c3/lib/libmbedtls.a",
+        "sdk/esp32c3/lib/libmbedtls_2.a",
+        "sdk/esp32c3/lib/libmbedcrypto.a",
+        "sdk/esp32c3/lib/libmbedx509.a",
+    ],
+))
+filegroup(name = "sdk_ld_esp32c3", srcs = glob(["sdk/esp32c3/ld/*.ld"]))
+filegroup(name = "ld_flags_esp32c3", srcs = ["sdk/esp32c3/flags/ld_flags"])
+filegroup(name = "ld_scripts_esp32c3", srcs = ["sdk/esp32c3/flags/ld_scripts"])
+
+
+# dropped those .a's from :sdk_libs_esp32c3 (mbedtls is built from source in
+# @mbedtls_src, linked via :core_esp32c3's deps). Strip those 4 -l tokens so ld doesn't
+# fail with "cannot find -lmbedtls"; the from-source lib satisfies the refs.
+genrule(
+    name = "ld_libs_no_mbedtls_esp32c3",
+    srcs = ["sdk/esp32c3/flags/ld_libs"],
+    outs = ["ld_libs_esp32c3.filtered"],
+    cmd = ("sed -E 's/-lmbedtls_2( |$$)/ /g; s/-lmbedtls( |$$)/ /g; " +
+           "s/-lmbedcrypto( |$$)/ /g; s/-lmbedx509( |$$)/ /g' $< > $@"),
+)
+
+filegroup(name = "ld_libs_esp32c3", srcs = [":ld_libs_esp32c3.filtered"])
+
+# Prebuilt pieces needed to assemble a bootable flash image (see esptool_flash).
+filegroup(name = "bootloader_elf_esp32c3", srcs = ["sdk/esp32c3/bin/bootloader_qio_80m.elf"])
+
+cc_library(
+    name = "sdk_hdrs_esp32c3",
+    hdrs = glob(
+        ["sdk/esp32c3/include/**/*.h", "sdk/esp32c3/qio_qspi/include/**/*.h",
+         "cores/esp32/**/*.h", "variants/esp32c3/**/*.h", "sdk/esp32c3/include/**/*.hpp",
+         "libraries/SPI/**/*.h"],
+        allow_empty = True,
+    ),
+    includes = [
+        "sdk/esp32c3/include/newlib/platform_include",
+        "sdk/esp32c3/include/freertos/config/include",
