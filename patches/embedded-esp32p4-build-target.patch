+# ESP32-P4 second-stage bootloader as a flashable .bin. The P4 ROM loads it from
+# 0x2000 (esptool_flash: bootloader_offset = "0x2000"). 16MB is the libs'
+# sdkconfig flash size; boards with more flash still boot from this header.
+genrule(
+    name = "esp32p4_bootloader_bin",
+    srcs = ["@arduino_esp32//:bootloader_elf_esp32p4"],
+    outs = ["esp32p4_bootloader.bin"],
+    cmd = ("$(execpath @esptool//:bin) --chip esp32p4 elf2image " +
+           "--flash_mode dio --flash_freq 80m --flash_size 16MB " +
+           "-o $@ $(location @arduino_esp32//:bootloader_elf_esp32p4)"),
+    tools = ["@esptool//:bin", "@esptool//:all"],
+)
+
 # Classic ESP32 (WROOM) second-stage bootloader. Same QIO-built/DIO-header
 # arrangement as the C6; this chip's ROM loads it from 0x1000, not 0x0.
 genrule(
diff --git a/libs/board/esp32p4.cpp b/libs/board/esp32p4.cpp
new file mode 100644
index 0000000..14c6894
--- /dev/null
+++ b/libs/board/esp32p4.cpp
@@ -0,0 +1,19 @@
+// ESP32-P4 board support. The P4 dev boards have no LED_BUILTIN; board_set_led is
+// a no-op unless the variant defines one.
+#include <Arduino.h>
+
+#include "libs/board/board.h"
+
+extern "C" void board_setup(void) {
+#ifdef LED_BUILTIN
+  pinMode(LED_BUILTIN, OUTPUT);
+#endif
+}
+
+extern "C" void board_set_led(bool on) {
+#ifdef LED_BUILTIN
+  digitalWrite(LED_BUILTIN, on ? HIGH : LOW);
+#else
+  (void)on;
+#endif
+}
