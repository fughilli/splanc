Bump @esptool to 5.6.0 (nix/esptool.nix): nixpkgs' esptool derivation overridden
with the v5.6.0 source, plus esp-pylib 1.2.0 (a 5.x dependency the nixos-25.11 pin
doesn't package). The pin's 5.1.0 can't flash an ESP32-P4 v3.x: its stub stops
responding on the first flash-id read. 5.6.0 flashes the P4 and packages the C6/C3
images as before. Drop when the nixpkgs pin carries esptool >= 5.6.

diff --git a/MODULE.bazel b/MODULE.bazel
index 1fb1773..bdd427e 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -121,9 +121,11 @@ nix_pkg.attr(name = "clang_tool", attr = "clang", repo = "@nixpkgs", build_file
 nix_pkg.attr(name = "libclang", attr = "llvmPackages.libclang.lib", repo = "@nixpkgs", build_file = "//nix:libclang.BUILD")
 
 # --- ESP32-C6 (Milestone 2) ------------------------------------------------
-# esptool — elf -> flashable .bin.
-nix_pkg.attr(
+# esptool — elf -> flashable .bin, and flashing. 5.6.0 from nix/esptool.nix (the
+# pinned nixpkgs' 5.1.0 can't flash an ESP32-P4 v3.x).
+nix_pkg.file(
     name = "esptool",
+    file = "//nix:esptool.nix",
     attr = "esptool",
     repo = "@nixpkgs",
     build_file = "//nix:esptool.BUILD",
diff --git a/nix/esptool.nix b/nix/esptool.nix
new file mode 100644
index 0000000..4b7b4ad
--- /dev/null
+++ b/nix/esptool.nix
@@ -0,0 +1,37 @@
+# esptool newer than the pinned nixpkgs' (nixos-25.11 ships 5.1.0). 5.1.0 can't
+# talk to an ESP32-P4 v3.x: its stub stops responding on the first flash-id read,
+# so flashing fails. 5.6.0 flashes it. Built by overriding nixpkgs' esptool with the
+# 5.6.0 source, plus esp-pylib, a dependency since 5.x that 25.11 doesn't package.
+# Drop this file for nixpkgs' esptool once the pin carries >= 5.6.
+let
+  pkgs = import <nixpkgs> { };
+  py = pkgs.python3Packages;
+  esp-pylib = py.buildPythonPackage rec {
+    pname = "esp_pylib";
+    version = "1.2.0";
+    format = "wheel";
+    src = py.fetchPypi {
+      inherit pname version format;
+      dist = "py3";
+      python = "py3";
+      hash = "sha256-WB/THrINtLgFGf6IPq6s9bPGosC3zONTp9Mmrny9T18=";
+    };
+    dependencies = with py; [ rich websockets pyserial rich-click click ];
+  };
+in
+{
+  esptool = pkgs.esptool.overridePythonAttrs (old: rec {
+    version = "5.6.0";
+    src = pkgs.fetchFromGitHub {
+      owner = "espressif";
+      repo = "esptool";
+      tag = "v${version}";
+      hash = "sha256-zVK9JoeObfl+Nii4mRC1mZbqDhEvufCFe0mqj24oRd0=";
+    };
+    dependencies = old.dependencies ++ [ esp-pylib ];
+    # The upstream test suite needs hardware or HSM fixtures nixpkgs patches per
+    # version; 5.1.0's postPatch doesn't apply to 5.6.0's tests.
+    postPatch = "patchShebangs ci";
+    doCheck = false;
+  });
+}
