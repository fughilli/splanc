diff --git a/tools/autoroute.py b/tools/autoroute.py
index a8e441e..f620ca1 100644
--- a/tools/autoroute.py
+++ b/tools/autoroute.py
@@ -12,7 +12,12 @@ Pipeline:
   2. FreeRouting (headless CLI)  -> board.ses
   3. pcbnew `ImportSpecctraSES`  -> traces back into the board, then Save.
 
-Usage: <kicad-python> autoroute.py <pcb_path> <freerouting_cmd>
+Usage: <kicad-python> autoroute.py <pcb_path> <freerouting_cmd> [max_passes]
+
+`max_passes` > 0 caps FreeRouting's optimization passes (`-mp`). On a densely /
+naively placed board FreeRouting keeps optimizing for many minutes; a small cap
+trades routing completeness for a bounded, tractable build (a preview, not a
+fab-quality route). 0 / omitted = unbounded (route to convergence).
 """
 
 from __future__ import annotations
@@ -25,6 +30,7 @@ import tempfile
 
 def main() -> int:
     pcb, freerouting = sys.argv[1], sys.argv[2]
+    max_passes = int(sys.argv[3]) if len(sys.argv) > 3 else 0
     import pcbnew  # provided by KiCad's Python
 
     board = pcbnew.LoadBoard(pcb)
@@ -40,10 +46,10 @@ def main() -> int:
     # is broken and can hang. The board must already have an Edge.Cuts boundary
     # (freerouting 2.1 scores NaN / routes nothing without one) — the outline
     # step runs before this. Quiet unless it fails; the java log is verbose.
-    proc = subprocess.run(
-        [freerouting, "-de", dsn, "-do", ses, "-gui.enabled", "false", "-mt", "1"],
-        capture_output=True, text=True,
-    )
+    cmd = [freerouting, "-de", dsn, "-do", ses, "-gui.enabled", "false", "-mt", "1"]
+    if max_passes > 0:
+        cmd += ["-mp", str(max_passes)]
+    proc = subprocess.run(cmd, capture_output=True, text=True)
     if not (os.path.exists(ses) and os.path.getsize(ses) > 0):
         sys.stderr.write(proc.stdout + proc.stderr)
         sys.exit("autoroute: FreeRouting produced no session (unroutable / failed)")
