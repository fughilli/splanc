     ])
 
-def _autoroute_step(ctx, pcb):
+def _autoroute_step(ctx, info, pcb):
     # Optional headless autorouting (opt in via `autoroute`): run FreeRouting
     # over the placed board via KiCad's pcbnew Python (DSN out -> route -> SES
     # in), so the exported board actually has traces — see tools/autoroute.py.
@@ -126,21 +126,36 @@ def _autoroute_step(ctx, pcb):
         return "", []
     fr = ctx.file.freerouting
     ap = ctx.file._autoroute
+
+    # A KiCad-provided Python (toolchain `kicad_python`) is preferred: KiCad ships
+    # `pcbnew` as a module (_pcbnew.so) but no standalone interpreter, so we point
+    # an interpreter at KiCad's site-packages — derived from the resolved
+    # kicad-cli's store path — via PYTHONPATH. Falls back to $KICAD_PYTHON, the
+    # macOS KiCad.app Python, then a plain python3.
+    ki_py = info.kicad_python.path if info.kicad_python else ""
+    ki_cli = _kicad_cmd(info)
     lines = [
         "_FR=\"$(cd \"$(dirname '%s')\" && pwd)/$(basename '%s')\"" % (fr.path, fr.path),
+        # Put KiCad's pcbnew site-packages on PYTHONPATH so `import pcbnew`
+        # resolves for the interpreter chosen below (matched by py-version/ABI).
+        '_KI_CLI="%s"' % ki_cli,
+        'command -v "$_KI_CLI" >/dev/null 2>&1 && _KI_CLI="$(command -v "$_KI_CLI")"',
+        '_KI_ROOT="$(cd "$(dirname "$(readlink -f "$_KI_CLI")")/.." 2>/dev/null && pwd || true)"',
+        '_KI_SP="$(ls -d "$_KI_ROOT"/lib/python3*/site-packages 2>/dev/null | head -1)"',
+        '[ -n "$_KI_SP" ] && export PYTHONPATH="$_KI_SP${PYTHONPATH:+:$PYTHONPATH}"',
         '_PCBNEW_PY=""',
-        'for _c in "${KICAD_PYTHON:-}" ' +
+        'for _c in "%s" "${KICAD_PYTHON:-}" ' % ki_py +
         '"/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3" ' +
         'python3; do',
         '  [ -n "$_c" ] || continue',
         '  if command -v "$_c" >/dev/null 2>&1 && "$_c" -c "import pcbnew" >/dev/null 2>&1; then _PCBNEW_PY="$_c"; break; fi',
         'done',
         'if [ -n "$_PCBNEW_PY" ]; then',
-        '  "$_PCBNEW_PY" "%s" "$ROOT/%s" "$_FR"' % (ap.path, pcb),
+        '  "$_PCBNEW_PY" "%s" "$ROOT/%s" "$_FR" %d' % (ap.path, pcb, ctx.attr.route_max_passes),
         'else',
         # Degrade gracefully: skip routing (board just has no traces) rather than
         # failing on a platform without KiCad's Python (e.g. kicad-small on Linux).
-        '  echo "autoroute: skipped — no pcbnew-capable python (need KiCad python; set KICAD_PYTHON)" >&2',
+        '  echo "autoroute: skipped — no pcbnew-capable python (set toolchain kicad_python or KICAD_PYTHON)" >&2',
         'fi',
     ]
     return "\n".join(lines), [fr, ap]
@@ -247,7 +262,7 @@ def _atopile_layout_impl(ctx):
 
     inputs = [_project_inputs(ctx, info)]
 
-    autoroute, ar_inputs = _autoroute_step(ctx, pcb)
+    autoroute, ar_inputs = _autoroute_step(ctx, info, pcb)
     if ar_inputs:
         inputs.append(depset(ar_inputs))
 
@@ -317,6 +332,7 @@ _atopile_layout = rule(
