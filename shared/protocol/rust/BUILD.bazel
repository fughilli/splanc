"""ledmapper.v1 — no_std Rust (micropb) bindings for the firmware targets.

Generated AT BUILD TIME, mirroring the Python bindings' genrule pattern: the
hermetic prebuilt protoc emits a descriptor set, and the micropb-gen driver
(gen_main.rs — also the single home of the container capacity table) turns it
into heapless-container Rust. Nothing is checked in.

The conformance test is the Rust leg of the cross-language golden
(web/tests/golden_proto_frames.json): every Python-encoded frame must decode
here and RE-ENCODE TO THE IDENTICAL BYTES, pinning micropb's presence and
packing behavior to canonical protobuf.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "ledmapper_fdset",
    srcs = ["//shared/protocol/proto:ledmapper.proto"],
    outs = ["ledmapper.fdset.bin"],
    cmd = "$(execpath //tools/toolchains:protoc) -I $$(dirname $(location //shared/protocol/proto:ledmapper.proto)) --descriptor_set_out=$@ $(location //shared/protocol/proto:ledmapper.proto)",
    tools = ["//tools/toolchains:protoc"],
)

rust_binary(
    name = "micropb_gen_bin",
    srcs = ["gen_main.rs"],
    edition = "2021",
    # @host_crates: the ISOLATED host-tool universe (see MODULE.bazel) — the
    # generator's micropb-with-std must not feature-unify onto the firmware's
    # no_std micropb in @crates.
    deps = ["@host_crates//:micropb-gen"],
)

# The generated module content becomes the crate root; the prepended
# `#![no_std]` keeps the crate buildable for the bare-metal targets. Two
# profiles from one proto (see gen_main.rs): `host` for conformance tests +
# fixture building, `firmware` with control-traffic-sized caps (the big
# uploads take the arena path on players).
[
    genrule(
        name = "ledmapper_rs_gen_" + profile,
        srcs = [":ledmapper_fdset"],
        outs = ["ledmapper_pb_" + profile + ".rs"],
        cmd = "$(execpath :micropb_gen_bin) $(location :ledmapper_fdset) $@.body " +
              profile +
              " && (echo '#![no_std]'; cat $@.body) > $@ && rm $@.body",
        tools = [":micropb_gen_bin"],
    )
    for profile in [
        "host",
        "firmware",
    ]
]

rust_library(
    name = "ledmapper_pb",
    srcs = [":ledmapper_rs_gen_host"],
    crate_root = ":ledmapper_rs_gen_host",
    edition = "2021",
    deps = ["@crates//:micropb"],
)

# Same crate name, firmware capacity profile — a target may depend on ONE of
# the two (they collide by crate name, by design: downstream code is
# identical either way).
rust_library(
    name = "ledmapper_pb_fw",
    srcs = [":ledmapper_rs_gen_firmware"],
    crate_name = "ledmapper_pb",
    crate_root = ":ledmapper_rs_gen_firmware",
    edition = "2021",
    deps = ["@crates//:micropb"],
)

rust_test(
    name = "conformance_test",
    srcs = ["tests/conformance.rs"],
    data = ["//web:tests/golden_proto_frames.json"],
    edition = "2021",
    env = {
        "GOLDEN_PROTO_FRAMES": "$(rootpath //web:tests/golden_proto_frames.json)",
        # The envelope structs carry inline heapless storage (hundreds of KB
        # for the map/solve arms) and land on the test thread's stack.
        "RUST_MIN_STACK": "16777216",
    },
    deps = [
        ":ledmapper_pb",
        "@crates//:base64",
        "@crates//:micropb",
        "@crates//:serde_json",
    ],
)
