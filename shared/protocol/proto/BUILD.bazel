"""ledmapper.v1 — the protobuf wire contract (§7) and its Python bindings.

Python bindings are GENERATED AT BUILD TIME by the hermetic prebuilt protoc
(toolchains_protoc) — nothing checked in; the runtime comes from pip
(`protobuf`). The TypeScript bindings (web/src/gen/) are generated by
protobuf-es and checked in next to the app sources — see gen_ts.sh.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files(["ledmapper.proto"])

genrule(
    name = "ledmapper_py_gen",
    srcs = ["ledmapper.proto"],
    outs = ["ledmapper_pb2.py"],
    cmd = "$(execpath //tools/toolchains:protoc) -I $$(dirname $(location ledmapper.proto)) --python_out=$(RULEDIR) $(location ledmapper.proto)",
    tools = ["//tools/toolchains:protoc"],
)

py_library(
    name = "ledmapper_py_proto",
    srcs = [":ledmapper_py_gen"],
    imports = ["."],
    deps = [requirement("protobuf")],
)
