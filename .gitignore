# --- Bazel ---------------------------------------------------------------
# Convenience symlinks (symlink_prefix = bazel- in .bazelrc) into the cache.
/bazel-*
# Project-local Bazel disk cache (--disk_cache in .bazelrc).
/.bazel-disk-cache/
# Project-local bazelisk download cache (BAZELISK_HOME in .bazeliskrc).
/.bazelisk/
# Project-local Bazel repository cache (--repository_cache in .bazelrc) —
# downloaded external archives, persisted across container restarts.
/.bazel-repo-cache/
# MODULE.bazel.lock IS committed (it's a lockfile) — do not ignore it.

# --- Node / pnpm ---------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# --- Web app -------------------------------------------------------------
# Vite bundles (bazel builds //web:dist; `pnpm --dir web build` for ad-hoc).
/web/dist/
# Runtime state written by `bazelisk run //web:serve`: self-signed TLS cert,
# capture session logs, reconstructed maps.
/.ledmapper/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# --- Nix (build results) -------------------------------------------------
# (deploy secrets are ignored by pi/provisioning/.gitignore)
/result
/result-*

# --- Secrets / credentials -----------------------------------------------
# Local-only private keys (e.g. the personal GitHub SSH key used to clone the
# private embedded/graph-extractor repos). Never commit these.
/credentials/

# --- Claude Code ---------------------------------------------------------
# Local, per-machine settings; the shared skill under .claude/skills/ and the
# container overlay ARE tracked.
.claude/settings.local.json

# --- Editor / OS ---------------------------------------------------------
.DS_Store
*.swp
*~
.idea/
.vscode/
/traces/

# --- Site Docs -----------------------------------------------------------
# Generated site docs (bazel run //docs:build)
/docs/site/

# sbc-deploy local build gc-roots/logs (consumer side)
.sbc-build/

# sbc-deploy nested repo checkout for local co-development (git_override'd; not
# vendored into this tree). Push it from its own repo, not from here.
/sbc-deploy-dev/

# hostdeploy runtime mailbox (container<->host deploy driver)
.hostdeploy/

# pi/bridge/flasher build outputs (packaging/build_app.*) + nix out-links
pi/bridge/flasher/dist/
pi/bridge/flasher/.pyibuild/
pi/bridge/flasher/version.json
pi/bridge/flasher/electron/node_modules/
pi/bridge/flasher/electron/dist/
pi/bridge/image/result*

# --- Cloudflare wrangler (agent/relay) local state ---
.wrangler/
# the OLED boot animation is generated (//pi/bridge:boot_frames), never committed
/pi/bridge/display/splanc_display/boot_frames.bin
