{
  "name": "splanc-bridge-flasher",
  "productName": "Splanc Bridge Flasher",
  "version": "0.0.0-dev",
  "description": "Write a Splanc bridge SD card for a Raspberry Pi: image, WiFi and name, no terminal",
  "main": "main.js",
  "author": "fughilli",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.splanc.bridge-flasher",
    "productName": "Splanc Bridge Flasher",
    "artifactName": "Splanc-Bridge-Flasher-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/splanc-flasher-sidecar",
        "to": "sidecar"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
