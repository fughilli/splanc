"""pi/bridge — the Raspberry Pi "Splanc bridge" appliance (README.md).

A Pi on the LAN running `splanc-agent bridge` headless, with its pairing code and
status on HDMI and on a Waveshare 1.3" OLED HAT. Ships inside the agent bundle
(//agent:bundle -> pi-bridge/, and site/bridge/install.sh for splanc.io); the Pi
gets it either as the ready-made SD image (image/, written by the Splanc Bridge
Flasher in flasher/) or, on Raspberry Pi OS, with
`curl -fsSL https://splanc.io/bridge/install.sh | sudo sh`.

Targets:
  :splanc_display   the display service (Python; Pillow + segno here, plus
                    luma.oled/gpiozero on the Pi — see display/requirements.lock)
  :display_test     renderer, status, button state machine, hardware seams, and
                    end to end against the fake bridge; writes PNGs of every
                    screen to the test's undeclared outputs
  :installer_test   install.sh into a fake root (install/upgrade/refusals/uninstall)
  :render_gallery   `bazel run //pi/bridge:render_gallery -- <dir>`: review PNGs
  :sim              `bazel run //pi/bridge:sim`: the display service on mocked
                    OLED/keys/HDMI, driven from a web page (splanc_display/sim.py)
  :boot_frames      the OLED boot animation, pre-rendered from shared/brand/splash
                    and web/public/icons/splanc.svg by tools/gen_boot_frames.py with
                    only Pillow: generated here (and in the NixOS image's
                    splancPy), never committed
  :bundle_files     what //agent:bundle packs as pi-bridge/, including mesh/pimesh
                    (//pi/mesh_radio:pimesh_musl, static aarch64): the bridge's mesh
                    member, which the SD image runs as splanc-mesh.service (issue #697)
"""

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["install.sh"])

py_binary(
    name = "gen_boot_frames",
    srcs = ["tools/gen_boot_frames.py"],
    deps = [requirement("pillow")],
)

py_library(
    name = "gen_boot_frames_lib",
    srcs = ["tools/gen_boot_frames.py"],
    imports = ["tools"],
    deps = [requirement("pillow")],
)

py_library(
    name = "gen_splash_assets_lib",
    srcs = ["tools/gen_splash_assets.py"],
    imports = ["tools"],
    deps = [requirement("pillow")],
)

genrule(
    name = "boot_frames",
    srcs = [
        "//shared/brand/splash:frames.json",
        "//web:public/icons/splanc.svg",
    ],
    outs = ["display/splanc_display/boot_frames.bin"],
    cmd = "$(location :gen_boot_frames) --svg $(location //web:public/icons/splanc.svg) --splash $(location //shared/brand/splash:frames.json) --out $@",
    tools = [":gen_boot_frames"],
)

py_library(
    name = "splanc_display",
    srcs = glob(["display/splanc_display/*.py"]),
    # The fonts every screen draws with, vendored (tools/vendor_fonts.py): the same
    # files here, in the agent bundle (:bundle_files) and in the NixOS image.
    data = [":boot_frames"] + glob(["display/splanc_display/fonts/**"]),
    imports = ["display"],
    deps = [
        requirement("pillow"),
        requirement("segno"),
    ],
)

py_test(
    name = "display_test",
    # medium: the suite grew (boot frames at 240 fps, the Life screensaver) and ran
    # past small's 60 s on the macOS runner (TIMEOUT at 62 s on aada6610b).
    size = "medium",
    srcs = glob(["tests/*.py"]),
    data = [
        "//shared/brand/splash:frames.json",
        "//web:public/icons/splanc.svg",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":gen_boot_frames_lib",
        ":gen_splash_assets_lib",
        ":splanc_display",
        "@rules_requirements//python",
        requirement("pytest"),
    ],
)

py_binary(
    name = "render_gallery",
    srcs = ["tools/render_gallery.py"],
    deps = [":splanc_display"],
)

py_binary(
    name = "sim",
    srcs = ["tools/display_sim.py"],
    main = "tools/display_sim.py",
    deps = [":splanc_display"],
)

# The mesh member (pimesh serve, pi/mesh_radio/src/bridge.rs) at pi-bridge/mesh/pimesh in
# the bundle: a static aarch64-linux-musl binary, so it runs on the NixOS image and on
# Raspberry Pi OS alike with no loader. The image runs the copy in its pinned bundle (a
# read-only store path), never one an update dropped in /var.
copy_file(
    name = "pimesh",
    src = "//pi/mesh_radio:pimesh_musl",
    out = "mesh/pimesh",
    is_executable = True,
)

filegroup(
    name = "bundle_files",
    srcs = [
        "display/requirements.lock",
        "install.sh",
        ":boot_frames",
        ":pimesh",
    ] + glob(
        [
            "bin/*",
            "display/splanc_display/*.py",
            "display/splanc_display/fonts/**",
            "systemd/*",
        ],
        exclude = ["display/splanc_display/sim*.py"],  # host-only (the simulator)
    ),
)

sh_test(
    name = "installer_test",
    size = "small",
    srcs = ["tests/installer_test.sh"],
    data = [":bundle_files"],
    # The installer only ever runs on Pi OS (Debian); its fake-root test leans on
    # GNU userland, so skip it on the macOS CI lane.
    target_compatible_with = ["@platforms//os:linux"],
)
