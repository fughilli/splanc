# LED Mapper — Raspberry Pi image + live-deploy, via the sbc-deploy framework
# (github.com/fughilli/sbc-deploy). Replaces the former hand-written
# image_sd/deploy_live/keys sh_binary wrappers.
#
#   bazel run //pi/provisioning:ledmapper.keys          -- init
#   bazel run //pi/provisioning:ledmapper.image_sd      -- --device /dev/sdX   # base + app
#   bazel run //pi/provisioning:ledmapper.image_sd_base -- --device /dev/sdX   # base only
#   bazel run //pi/provisioning:ledmapper.deploy_live   -- ledmapper.local     # push app
#   bazel run //pi/provisioning:ledmapper.ssh           -- ledmapper.local     # shell in
#
# On macOS, start the aarch64-linux builder first: `bazel run @sbc_deploy//:linux_builder`.

load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

sbc_application(
    name = "ledmapper",
    flake = "pi/provisioning/nix",
    hostname = "ledmapper",
    # Self-contained: the Nix side pins sbc-deploy via the flake input +
    # pi/provisioning/nix/flake.lock (parallel to the git_override in
    # //MODULE.bazel), so no in-tree `framework=` injection.
)
