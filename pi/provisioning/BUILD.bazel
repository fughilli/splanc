# LED Mapper — Raspberry Pi image + live-deploy, via the sbc-deploy framework
# (github.com/fughilli/sbc-deploy). Replaces the former hand-written
# image_sd/deploy_live/keys sh_binary wrappers.
#
#   bazel run //pi/provisioning:ledmapper.keys          -- init
#   bazel run //pi/provisioning:ledmapper.image_sd      -- --device /dev/sdX   # base + app
#   bazel run //pi/provisioning:ledmapper.image_sd_base -- --device /dev/sdX   # base only
#   bazel run //pi/provisioning:ledmapper.deploy_live   -- ledmapper.local     # push app
#   bazel run //pi/provisioning:ledmapper.ssh           -- ledmapper.local     # shell in
#
# On macOS, start the aarch64-linux builder first: `bazel run @sbc_deploy//:linux_builder`.

load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

sbc_application(
    name = "ledmapper",
    # The spi_ws281x FPGA gateware, injected into the flake build as a generic
    # data dependency (-> sbcBuildData."spi_ws281x_tangnano9k.fs" in apps.nix).
    # No vendored/copied bitstream — Bazel is the single source.
    build_data = [
        "//fpga/spi_ws281x:spi_ws281x_tangnano9k",
        # The Rust player binary (staged, autoPatchelf'd in the image).
        "//pi/player_rs/musl:player_musl",
    ],
    flake = "pi/provisioning/nix",
    hostname = "ledmapper",
    # Self-contained: the Nix side pins sbc-deploy via the flake input +
    # pi/provisioning/nix/flake.lock (parallel to the git_override in
    # //MODULE.bazel), so no in-tree `framework=` injection.
)

# Raspberry Pi 3B/3B+ board variant of the SAME flake + config (:ledmapper above
# is the Pi 5 board). The `board` attr overrides the flake's default
# board = "raspberry-pi-5" at build time via $SBC_BOARD (impure eval), so no flake
# fork is needed. Gives //pi/provisioning:ledmapper_pi3.{keys,image_sd,
# image_sd_base,deploy_live,ssh}, e.g.:
#   bazel run //pi/provisioning:ledmapper_pi3.image_sd -- --device /dev/sdX
sbc_application(
    name = "ledmapper_pi3",
    board = "@sbc_deploy//deploy/boards:raspberry-pi-3",
    build_data = [
        "//fpga/spi_ws281x:spi_ws281x_tangnano9k",
        # The Rust player binary (staged, autoPatchelf'd in the image).
        "//pi/player_rs/musl:player_musl",
    ],
    flake = "pi/provisioning/nix",
    hostname = "ledmapper",
)

# Board-autodetecting deploy for an already-commissioned board. `:update` reads
# the board's own HARDWARE (Pi 5 vs Pi 3 -> SBC_BOARD) and committed identity and
# deploys the MATCHING closure — so there's no per-board target to remember and no
# way to push a mismatched closure (e.g. the Pi 5 `ledmapper` closure onto a Pi 3,
# which installs an incompatible kernel and bricks the next boot). Prefer this over
# `ledmapper[_pi3].deploy_live` once a board is imaged. Mirrors //pi/hitl:update.
#   bazel run //pi/provisioning:update -- splanc-max-1.local
alias(
    name = "update",
    actual = ":ledmapper.update",
)
