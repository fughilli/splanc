"""HITL pure-logic unit tests (FUG-33).

The Improv packet codec and SNTP sync math — the pieces that must not drift from
the firmware/app. No hardware, no network. The modules under test live in
//pi/hitl/harness; this dir holds only tests (the repo's name-tests-test
convention). (Runner-pool selection now lives in the Go CLI, tested in
//pi/hitl/internal/pool and //pi/hitl/internal/tailnet.)

These are pure-logic units (no hardware, no network), so they run in the normal
`bazel test //...` suite on every build, enforcing device/app/harness parity.
(The on-hardware harness binaries — e2e, map_upload, mapping_trigger, fx_bench,
rename_wss, video_stream — are separate `manual` py_binaries, run by the dedicated
.github/workflows/hitl.yaml workflow against a real rig.) `imports = ["."]` + the
harness dep put both the test files and the modules under test on the top-level
import path.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "hitl_test",
    srcs = [
        "pytest_main.py",
        "test_fx_bench.py",
        "test_hardware_config_pattern.py",
        "test_improv.py",
        "test_improv_find.py",
        "test_jit_soak.py",
        "test_led_pattern.py",
        "test_map_upload.py",
        "test_mapping_trigger.py",
        "test_provision.py",
        "test_sync.py",
        "test_tls_churn.py",
        "test_uniform_bench.py",
        "test_video_bench.py",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "pytest_main.py",
    deps = [
        "//pi/hitl/harness",
        requirement("pytest"),
    ],
)
