load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runner",
    srcs = [
        "capture.go",
        "podman.go",
        "runner.go",
        "usbport.go",
    ],
    importpath = "github.com/fughilli/splanc/pi/hitl/internal/runner",
    visibility = ["//pi/hitl:__subpackages__"],
    deps = ["//pi/hitl/internal/api"],
)

go_test(
    name = "runner_test",
    srcs = [
        "capture_test.go",
        "podman_test.go",
        "usbport_test.go",
    ],
    embed = [":runner"],
)

# Source files staged into the hermetic flake TreeArtifact (sbc_application
# flake_srcs) so `nix build` reads deterministic content, never the live
# workspace. Referenced by //pi/hitl:flake_srcs.
filegroup(
    name = "flake_srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//pi/hitl:__pkg__"],
)
