load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "analyzer",
    srcs = [
        "analyzer.go",
        "decode.go",
        "srzip.go",
    ],
    importpath = "github.com/fughilli/splanc/pi/hitl/internal/analyzer",
    visibility = ["//pi/hitl:__subpackages__"],
    deps = ["//pi/hitl/internal/api"],
)

go_test(
    name = "analyzer_test",
    srcs = [
        "channelmap_test.go",
        "decode_test.go",
        "golden_test.go",
        "srzip_test.go",
    ],
    embed = [":analyzer"],
    deps = ["//pi/hitl/internal/api"],
)

# Source files staged into the hermetic flake TreeArtifact (sbc_application
# flake_srcs) so `nix build` reads deterministic content, never the live
# workspace. Referenced by //pi/hitl:flake_srcs.
filegroup(
    name = "flake_srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//pi/hitl:__pkg__"],
)
