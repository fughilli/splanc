load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "metrics",
    srcs = ["metrics.go"],
    importpath = "github.com/fughilli/splanc/pi/hitl/internal/metrics",
    visibility = ["//pi/hitl:__subpackages__"],
)

go_test(
    name = "metrics_test",
    srcs = ["metrics_test.go"],
    embed = [":metrics"],
)

# Source files staged into the hermetic flake TreeArtifact (sbc_application
# flake_srcs) so `nix build` reads deterministic content, never the live
# workspace. Referenced by //pi/hitl:flake_srcs.
filegroup(
    name = "flake_srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//pi/hitl:__pkg__"],
)
