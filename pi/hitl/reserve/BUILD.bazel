# Consumes the extracted hitl-reserve Bazel module (@hitl_reserve). These aliases
# expose the generalized reservation daemon + CLI to splanc's build graph, driven
# by the splanc-fleet catalog.json in this directory. Additive: the existing
# //pi/hitl/cmd/hitl-managerd daemon is untouched; this is the migration target.
#
#   bazel run //pi/hitl/reserve:hitl-reserved -- \
#     --catalog $(bazel info workspace)/pi/hitl/reserve/catalog.json --host $(hostname)
#   bazel run //pi/hitl/reserve:hitl -- status

package(default_visibility = ["//visibility:public"])

alias(
    name = "hitl-reserved",  # the reservation daemon
    actual = "@hitl_reserve//cmd/hitl-reserved",
)

alias(
    name = "hitl",  # the client CLI
    actual = "@hitl_reserve//cmd/hitl",
)

exports_files(["catalog.json"])
