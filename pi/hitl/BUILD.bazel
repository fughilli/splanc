# HITL rig — Pi image + live-deploy, via the sbc-deploy framework.
#
#   bazel run //pi/hitl:hitl.keys        -- init
#   bazel run //pi/hitl:hitl.image_sd    -- --device /dev/sdX   # full: base + HITL app
#   bazel run //pi/hitl:hitl.deploy_live -- hitl-rig            # push to a running rig
#   bazel run //pi/hitl:hitl.ssh         -- hitl-rig            # shell into the rig itself
#
# The agent-facing CLI is the Nix package `//pi/hitl (flake) #hitl`:
#   nix run 'path:pi/hitl#hitl' -- reserve
# On macOS, start the aarch64-linux builder first: bazel run @sbc_deploy//:linux_builder.

load("@gazelle//:def.bzl", "gazelle")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

# The SKU -> capabilities registry lives in skus.bzl (source of truth) + the
# go:embedded internal/skus package. See //pi/hitl/internal/skus.
exports_files(["skus.bzl"])

# Go BUILD files under pi/hitl are gazelle-generated. Regenerate after editing
# .go sources:  bazel run //pi/hitl:gazelle
# gazelle:prefix github.com/fughilli/splanc/pi/hitl
gazelle(name = "gazelle")

# Default to the tracked placeholder so a fresh checkout / CI builds; a local
# (gitignored) wifi.yaml with real SSID/PSKs overrides it when present. Without any
# wifi the rig bakes no profile and gets stranded when moved. The constant glob is
# intentional — it's a "use this file if it exists" probe, not a pattern match.
# buildifier: disable=constant-glob
_wifi_config = (glob(
    ["wifi.yaml"],
    allow_empty = True,
) or ["wifi.yaml.example"])[0]

sbc_application(
    name = "hitl",
    # Hybrid detect-warn for `:update`: probe the board for the Saleae Logic
    # analyzer (USB 0925:3881) and report the capability it implies; `.update`
    # warns if this disagrees with the board's committed /var/lib/sbc/profile.
    detect_caps_cmd = "lsusb | grep -q 0925:3881 && echo SBC_ANALYZER=1 || echo SBC_ANALYZER=0",
    flake = "pi/hitl",
    hostname = "hitl-rig",
    wifi_config_file = _wifi_config,
)

# The one-shot "make this rig current" deploy. `:update` reads the board's own
# hardware (Pi 5 vs Pi 3 -> SBC_BOARD) and committed capability profile
# (/var/lib/sbc/profile -> SBC_ANALYZER etc.) and deploys the matching closure —
# no per-board target or SBC_* flags to remember, and the identity is reused from
# the board (never reset). Aliased to :hitl.update since update autodetects the
# board, so it serves every rig (incl. the Pi 3):
#   bazel run //pi/hitl:update -- hitl-rig-2   # detects LA Pi5, analyzer profile
alias(
    name = "update",
    actual = ":hitl.update",
)

# Raspberry Pi 3B/3B+ board variant of the SAME flake + config (:hitl above is the
# Pi 5 board). Capability is NO LONGER tied to the board: nix/hitl-app.nix keys the
# logic analyzer on $SBC_ANALYZER and the dedicated-AP-radio dongle on
# $SBC_AP_DONGLE (both default off), independent of $SBC_BOARD — so you can deploy
# a plain Pi 3, an analyzer Pi 5, etc. Gives //pi/hitl:hitl_pi3.{image_sd,
# deploy_live,ssh,keys}. See DESIGN.md "Shared logic analyzer" and internal/analyzer.
#
# hostname = "hitl-rig" is the config's baked hostName / nixosConfigurations attr
# (mkSbcProject { hostName = "hitl-rig"; }) that deploy_live/ssh build — NOT the
# per-board machine name. The machine identity is the operator's --hostname flag,
# and capabilities are env flags, both per-deploy, e.g. a plain Pi 3:
#   bazel run //pi/hitl:hitl_pi3.deploy_live -- --hostname hitl-rig-3 <host>
# or an analyzer Pi 5:
#   SBC_ANALYZER=1 bazel run //pi/hitl:hitl.deploy_live -- --hostname hitl-rig-2 <host>
sbc_application(
    name = "hitl_pi3",
    board = "@sbc_deploy//deploy/boards:raspberry-pi-3",
    flake = "pi/hitl",
    hostname = "hitl-rig",
    wifi_config_file = _wifi_config,
)

# Seed persistent (runtime) WiFi networks onto the running rig, composed on top of
# the baked BigVibes/FugLink without a rebuild:
#   bazel run //pi/hitl:seed_wifi                       # seed pi/secrets/wifi-seed.yaml
#   bazel run //pi/hitl:seed_wifi -- --ssid X --psk Y   # one-off
#   bazel run //pi/hitl:seed_wifi -- --list / --remove SSID
sh_binary(
    name = "seed_wifi",
    srcs = ["scripts/seed-wifi.sh"],
    data = ["@sbc_deploy//deploy:scripts/seed_wifi.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Re-seed the Tailscale auth key onto the rig (needed after a reflash wipes
# /var/lib). Reads pi/secrets/tailscale-authkey + deploy_key.
#   bazel run //pi/hitl:seed_tailscale_authkey [-- host]
sh_binary(
    name = "seed_tailscale_authkey",
    srcs = ["scripts/seed-tailscale-authkey.sh"],
)

# Seed the Grafana Cloud creds onto the rig and (re)start Alloy, wiring the rig
# to Grafana Cloud. Reads pi/secrets/grafana.env + deploy_key. See
# observability/README.md and observability/alloy.nix.
#   bazel run //pi/hitl:seed_grafana [-- host]
sh_binary(
    name = "seed_grafana",
    srcs = ["scripts/seed-grafana.sh"],
)

# Attach a network DUT (a Pi reached over the LAN + provisioned over BLE) to a
# running rig so it gets its own work queue — seeded, not baked. See the script
# header and pi/hitl/DESIGN.md.
#   bazel run //pi/hitl:seed_network_dut -- [host] --name pi-… --addr …
sh_binary(
    name = "seed_network_dut",
    srcs = ["scripts/seed-network-dut.sh"],
)

# HTTP-driven runner for the on-hardware HITL suite (see the file's docstring).
# Run it on a tailnet host where the rigs work, then curl it to run the harness
# py_tests one at a time. Lives in //pi/hitl (not a scripts/ subpackage) so the
# scripts/*.sh seed targets above stay valid. Stdlib only; shells back out to
# `bazel` under $BUILD_WORKSPACE_DIRECTORY.
#   bazel run //pi/hitl:hitl_shim          # or: python3 pi/hitl/scripts/hitl_shim.py
py_binary(
    name = "hitl_shim",
    srcs = ["scripts/hitl_shim.py"],
    visibility = ["//visibility:public"],
)
