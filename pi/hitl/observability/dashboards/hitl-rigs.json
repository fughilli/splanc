{
  "title": "HITL Rigs",
  "uid": "hitl-rigs",
  "tags": ["hitl", "splanc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "rig",
        "label": "Rig",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "definition": "label_values(hitl_up, rig)",
        "query": { "query": "label_values(hitl_up, rig)", "refId": "rig" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DUTs busy",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum(hitl_duts_busy{rig=~\"$rig\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DUTs total",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum(hitl_duts_total{rig=~\"$rig\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Queue depth (fleet)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum(hitl_queue_depth{rig=~\"$rig\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rigs up",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "count(hitl_up{rig=~\"$rig\"} == 1)"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Reservation queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue depth by rig",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stepAfter": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "hitl_queue_depth{rig=~\"$rig\"}",
          "legendFormat": "{{rig}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DUTs busy by rig",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20, "stepAfter": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "hitl_duts_busy{rig=~\"$rig\"}",
          "legendFormat": "{{rig}} busy"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "hitl_duts_total{rig=~\"$rig\"}",
          "legendFormat": "{{rig}} total"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reservation rate (per min)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (rig) (rate(hitl_reservations_total{rig=~\"$rig\"}[$__rate_interval])) * 60",
          "legendFormat": "{{rig}} reserved"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (rig) (rate(hitl_activations_total{rig=~\"$rig\"}[$__rate_interval])) * 60",
          "legendFormat": "{{rig}} activated"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Lease expiries & start failures (per min)",
      "description": "Nonzero lease-expiry or start-failure rates flag stuck clients or broken DUTs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (rig) (rate(hitl_lease_expirations_total{rig=~\"$rig\"}[$__rate_interval])) * 60",
          "legendFormat": "{{rig}} lease-expiry"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "sum by (rig) (rate(hitl_start_failures_total{rig=~\"$rig\"}[$__rate_interval])) * 60",
          "legendFormat": "{{rig}} start-fail"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Host resources",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Load average (1m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "hitl_host_load1{rig=~\"$rig\"}",
          "legendFormat": "{{rig}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Memory used %",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "100 * (1 - hitl_host_memory_available_bytes{rig=~\"$rig\"} / hitl_host_memory_total_bytes{rig=~\"$rig\"})",
          "legendFormat": "{{rig}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "SoC temperature",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
          "expr": "hitl_host_temperature_celsius{rig=~\"$rig\"}",
          "legendFormat": "{{rig}}"
        }
      ]
    }
  ]
}
