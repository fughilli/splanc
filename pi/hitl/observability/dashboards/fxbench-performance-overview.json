    {
      "id": 1,
      "type": "timeseries",
      "title": "Overall performance index \u2014 mean ln(measured/golden) per commit (0 = at golden; +0.02 \u2248 +2% slower)",
      "description": "Geomean of the selected effects' drift, in log space. A plain mean of per-row ln_ratio (native group-by), since Grafana/JSONata have no exp/log. Sustained departure from 0 = systematic drift across the subset.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "grafanacloud-infinity"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "custom.axisLabel": "log-drift index (\u2248 fractional slowdown)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 0,
                "color": "#808080"
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
