# Same e2e driver, but against the HEAPLESS-NETSTACK player variant
# (//firmware/player_app:esp32c6_netstack): BLE Improv provisioning -> our heapless
# MAC/WPA2/CCMP/DHCP/TCP/TLS/WS -> lm_player_handle, no vendor WiFi on the data path.
# $HITL_BUNDLE_RUNFILE points default_bundle() at the netstack bundle in this target's
# runfiles; the board-caps descriptor is identical (same C6 board).
py_test(
    name = "e2e_netstack",
    timeout = "eternal",
    srcs = ["hitl_e2e.py"],
    data = [
        "//firmware/player_app:board_caps.textproto",
        "//firmware/player_app:esp32c6_netstack_flashbundle",
        "@hitl_reserve//cmd/hitl",
    ],
    env = {
        "HITL_BUNDLE_RUNFILE": "_main/firmware/player_app/esp32c6_netstack_flashbundle.tar",
        # Reserve only esp32c6-type DUTs: rig-3 now carries a correctly-labeled
        # esp32c3 DUT alongside its c6s, and an unfiltered reservation would
        # sometimes land on it (esptool: "This chip is ESP32-C3 not ESP32-C6").
        # hitl_client.Reservation reads $HITL_SKU into unit_type, so this filters
        # by the unit's `type` — which every real c6 DUT has (even old-daemon rigs
        # that carry no chip:* cap), so it never de-matches rig-1/rig-2.
        "HITL_SKU": "esp32c6",
    },
    imports = ["."],
    main = "hitl_e2e.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        "@rules_requirements//python",
        requirement("websockets"),
    ],
)

