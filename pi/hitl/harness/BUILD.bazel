# Same sharded-upload test against the heapless esp32c6_netstack drop-in. The
# from-scratch TLS decrypts each record into one contiguous heap buffer while
# BLE+WiFi+LED+FX are all resident, so a 4KB record overflows the C6's fragmented
# DMA/internal heap (a genuine RAM ceiling — the full record arrives and is ACKed;
# only the decrypt allocation fails). HITL_CHUNK_BYTES=1024 keeps each window one
# small record, which the drop-in uploads + round-trips cleanly. (esp-aes: Failed to
# allocate / mbedtls Dynamic Impl alloc failed at 4096; PASS at 1024.)
py_test(
    name = "map_upload_netstack",
    timeout = "eternal",
    srcs = ["hitl_map_upload.py"],
    data = [
        "//firmware/player_app:esp32c6_netstack_flashbundle",
        "@hitl_reserve//cmd/hitl",
    ],
    env = {
        "HITL_BUNDLE_RUNFILE": "_main/firmware/player_app/esp32c6_netstack_flashbundle.tar",
        "HITL_CHUNK_BYTES": "1024",
    },
    imports = ["."],
    main = "hitl_map_upload.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# Connection-churn resilience against the heapless esp32c6_netstack drop-in. The netstack
# TLS server is SINGLE-connection (one TcpConn / one ~6 KB mbedTLS session), so it serves
# one and sheds the rest — excess SYNs are never accepted, so there is no multi-session heap
# pressure; the anti-wedge gate is that a clean wss handshake recovers within --recover-window
# (the dead-peer RTO re-listen frees a vanished client's slot well inside the default 40s).
py_test(
    name = "tls_churn_netstack",
    timeout = "eternal",
    srcs = ["hitl_tls_churn.py"],
    args = ["--skip-nvs-reboot"],
    data = [
        "//firmware/player_app:esp32c6_netstack_flashbundle",
        "@hitl_reserve//cmd/hitl",
    ],
    env = {
        "HITL_BUNDLE_RUNFILE": "_main/firmware/player_app/esp32c6_netstack_flashbundle.tar",
    },
    imports = ["."],
    main = "hitl_tls_churn.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

