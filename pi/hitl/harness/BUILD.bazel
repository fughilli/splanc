"""HITL Python harness — the reservation client + e2e driver (FUG-33).

The library half of the suite: the checkout client (`hitl_client`, a thin wrapper
that shells out to the Go `hitl` CLI — reservation, server selection, and
tunneling all live there now, not in Python) and the pure Improv/SNTP codecs
(`improv`, `sync`) the unit tests in //pi/hitl/tests pin. Kept out of the
`tests/` directory so that dir holds only tests (the repo's name-tests-test
convention); the codecs are imported both here and by the container's
`hitl-improv` tool, which must not drift from them.

`imports = ["."]` puts this directory on the import path so the modules are
importable as top-level (hitl_client, sync, improv) the way they import each
other.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "harness",
    srcs = [
        "fx_bench_core.py",
        "hitl_client.py",
        "hitl_improv.py",
        "improv.py",
        "map_upload_core.py",
        "mapping_trigger_core.py",
        "provision.py",
        "sync.py",
    ],
    imports = ["."],
)

# On-hardware orchestrator: reserve a free rig from the pool (the checkout
# mechanism), flash, ImprovBLE-provision, then check time-sync + rename over the
# player WebSocket. proto_wire (the §7 WebSocket wire) comes from //pi/server;
# websockets is the client transport. Needs a reachable rig + a board, so it is
# `bazel run`, never `bazel test`. Tagged for grouping with the rest of the HITL
# surface and kept out of any wildcard build/run; it runs from the manual
# .github/workflows/hitl.yaml workflow.
py_binary(
    name = "e2e",
    srcs = ["hitl_e2e.py"],
    # The firmware flash-bundle rides in runfiles so `bazel run` finds it without
    # a separate build step or a workspace-relative path (bazel run's cwd is the
    # runfiles tree). --bundle still overrides it for a prebuilt tar. The `hitl`
    # CLI also rides in runfiles: hitl_client shells out to it for the whole
    # reserve/flash/tunnel flow (default_hitl() resolves it there).
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_e2e.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# On-hardware mapping-sequence-trigger test (FUG-62): reserve a rig, flash,
# activate an effect, send start_mapping, and assert the device shows
# mapping-pattern frames (get_frame_timing ticks) — the regression guard for the
# render_once reorder that lets a capture preempt a resumed effect. Like :e2e /
# :fx_bench it needs a rig + board, so it is `bazel run`, never `bazel test`; the
# verdict logic (mapping_trigger_core) is unit-tested in //pi/hitl/tests. It
# reuses an .fx from the fx benchmarks (compiled via fx_compile) just to obtain a
# valid active effect, and rides the flash-bundle + hitl CLI in runfiles.
py_binary(
    name = "mapping_trigger",
    srcs = ["hitl_mapping.py"],
    data = [
        ":fx_benchmarks",
        "//firmware/player_app:esp32c6_flashbundle",
        "//fx_compiler:fx_compile",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_mapping.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# The calibration micro-programs (FUG-11), as `.fx` source the harness compiles
# with fx_compile and runs on the real C6. Auto-generated from the web
# calibration source of truth (web/src/effects/calibrationBenchmarks.ts, via
# benchmarkExport.ts) so the in-browser and on-hardware runs measure the SAME
# programs; the drift test (//web:unit_tests) pins that. `*.heldout.fx` is the
# validation set the fit never sees. Every file compiles under //fx_compiler.
filegroup(
    name = "fx_benchmarks",
    srcs = glob(["benchmarks/*.fx"]),
)

# On-hardware FX benchmark (FUG-11): reserve a rig, flash, drive the calibration
# micro-programs on the real C6, and write a device-measurement bundle for the
# web builder to fit + validate into an authoritative cost profile. Like :e2e it
# needs a rig + board, so it is `bazel run`, never `bazel test`; the pure logic
# it depends on (fx_bench_core) is unit-tested in //pi/hitl/tests. --replay
# rebuilds a bundle from a recorded session with no hardware. The calibration
# `.fx` programs and the fx_compile CLI ride in runfiles so `bazel run` finds
# them without a workspace-relative path (default --benchmarks-dir/--fx-compile).
py_binary(
    name = "fx_bench",
    srcs = ["fx_bench.py"],
    data = [
        ":fx_benchmarks",
        "//firmware/player_app:esp32c6_flashbundle",
        "//fx_compiler:fx_compile",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "fx_bench.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# On-hardware large-map upload test (FUG-74): reserve a rig, flash, then shard a
# ~14 KB submit_map + a multi-KB submit_topology into UploadChunk windows over
# the player WebSocket and assert they upload, decode, and round-trip via
# get_stored_map — the regression guard for the wss OOM ("Send failed: socket
# closed") on a big map. Like :e2e it needs a rig + board, so it is `bazel run`,
# never `bazel test`; the chunking/fixture logic (map_upload_core) is unit-tested
# in //pi/hitl/tests. --device-ws hits an already-reachable board directly.
py_binary(
    name = "map_upload",
    srcs = ["hitl_map_upload.py"],
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_map_upload.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# On-hardware rename -> wss-wedge repro (FUG-85 follow-up): reserve, flash,
# provision, then rename the device and probe whether its TLS server recovers,
# capturing the serial `[wss]`/heap lines. `bazel run`, never `bazel test`.
py_binary(
    name = "rename_wss",
    srcs = ["hitl_rename_wss.py"],
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_rename_wss.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)
