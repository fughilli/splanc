"""HITL Python harness — the reservation client + e2e driver (FUG-33).

The library half of the suite: the checkout client (`hitl_client`, a thin wrapper
that shells out to the Go `hitl` CLI — reservation, server selection, and
tunneling all live there now, not in Python) and the pure Improv/SNTP codecs
(`improv`, `sync`) the unit tests in //pi/hitl/tests pin. Kept out of the
`tests/` directory so that dir holds only tests (the repo's name-tests-test
convention); the codecs are imported both here and by the container's
`hitl-improv` tool, which must not drift from them.

`imports = ["."]` puts this directory on the import path so the modules are
importable as top-level (hitl_client, sync, improv) the way they import each
other.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "harness",
    srcs = [
        "fx_bench_core.py",
        "heap_floor_core.py",
        "hitl_client.py",
        "hitl_improv.py",
        "improv.py",
        "led_pattern.py",
        "map_upload_core.py",
        "mapping_trigger_core.py",
        "provision.py",
        "sync.py",
        "uniform_bench_core.py",
        "video_bench_core.py",
    ],
    imports = ["."],
)

# On-hardware orchestrator: reserve a free rig from the pool (the checkout
# mechanism), flash, ImprovBLE-provision, then check time-sync + rename over the
# player WebSocket. proto_wire (the §7 WebSocket wire) comes from //pi/server;
# websockets is the client transport. Needs a reachable rig + a board, so it's a
# py_test tagged ["manual", "hitl"]: `manual` keeps it out of `bazel test //...`,
# and the .github/workflows/hitl.yaml workflow discovers the `hitl`-tagged tests
# by query and `bazel test`s them against a real rig (timeout=eternal — a
# flash+provision cycle runs minutes). Still `bazel run`-able for a local one-off.
py_test(
    name = "e2e",
    timeout = "eternal",
    srcs = ["hitl_e2e.py"],
    # The firmware flash-bundle rides in runfiles so `bazel run` finds it without
    # a separate build step or a workspace-relative path (bazel run's cwd is the
    # runfiles tree). --bundle still overrides it for a prebuilt tar. The `hitl`
    # CLI also rides in runfiles: hitl_client shells out to it for the whole
    # reserve/flash/tunnel flow (default_hitl() resolves it there).
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_e2e.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# On-hardware LED-driver correctness test (logic-analyzer rig): reserve, flash,
# provision, drive a static counting pattern over the player WebSocket, then
# `hitl-capture` the WS2812 wire via the rig's shared FX2 and assert the decoded
# pixels match. Needs a logic-analyzer rig (Pi 3 + FX2 tapping the DUT's DIN), so
# it's manual+hitl like :e2e; the pattern/pixel contract is unit-tested off
# hardware in //pi/hitl/tests:hitl_test (test_led_pattern.py). The `hitl-capture`
# tool itself is baked into the reservation container (nix/container.nix).
py_test(
    name = "led_capture",
    timeout = "eternal",
    srcs = ["hitl_led_capture.py"],
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_led_capture.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

