# keys on the SKU, and netstack is the same esp32c6 SKU as vendor) — a standalone
# py_test that points default_bundle() at the netstack flashbundle, mirroring
# e2e_netstack. Reserves any esp32c6 with flash+improv caps.
py_test(
    name = "ble_player_e2e_netstack",
    timeout = "eternal",
    srcs = [
        "hitl_ble_player.py",
        "hitl_ble_player_e2e.py",
