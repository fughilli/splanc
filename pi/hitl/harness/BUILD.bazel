"""HITL Python harness — the reservation client + e2e driver (FUG-33).

The library half of the suite: the checkout client (`hitl_client`, a thin wrapper
that shells out to the Go `hitl` CLI — reservation, server selection, and
tunneling all live there now, not in Python) and the pure Improv/SNTP codecs
(`improv`, `sync`) the unit tests in //pi/hitl/tests pin. Kept out of the
`tests/` directory so that dir holds only tests (the repo's name-tests-test
convention); the codecs are imported both here and by the container's
`hitl-improv` tool, which must not drift from them.

`imports = ["."]` puts this directory on the import path so the modules are
importable as top-level (hitl_client, sync, improv) the way they import each
other.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":hitl_test.bzl", "hitl_test")

package(default_visibility = ["//visibility:public"])

# Cross-hardware Improv-provisioning contract test. Fans out (via the SKU registry
# in //pi/hitl:skus.bzl) to one hitl-tagged target per SKU with the "improv"
# capability — today improv_e2e_esp32c6 + improv_e2e_led-mapper-pi. Reuses
# hitl_e2e.flash (C6 path) + provision.provision_dut. See hitl_test.bzl.
hitl_test(
    name = "improv_e2e",
    srcs = [
        "hitl_e2e.py",  # reused for flash() + default_bundle() on the C6 path
        "hitl_improv_e2e.py",
    ],
    data = [
        "//firmware/player_app:board_caps.textproto",
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    main = "hitl_improv_e2e.py",
    requires = ["improv"],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

py_library(
    name = "harness",
    srcs = [
        "board_caps.py",
        "fx_bench_core.py",
        "hardware_config_pattern.py",
        "hitl_client.py",
        "hitl_improv.py",
        "improv.py",
        "jit_soak_core.py",
        "led_pattern.py",
        "map_upload_core.py",
        "mapping_trigger_core.py",
        "provision.py",
        "sync.py",
        "tls_churn_core.py",
        "uniform_bench_core.py",
        "video_bench_core.py",
    ],
    imports = ["."],
    # board_caps parses the BoardCapabilities textproto via the generated py proto.
    deps = ["//shared/protocol/proto:ledmapper_py_proto"],
)

# On-hardware orchestrator: reserve a free rig from the pool (the checkout
# mechanism), flash, ImprovBLE-provision, then check time-sync + rename over the
# player WebSocket. proto_wire (the §7 WebSocket wire) comes from //pi/server;
# websockets is the client transport. Needs a reachable rig + a board, so it's a
# py_test tagged ["manual", "hitl"]: `manual` keeps it out of `bazel test //...`,
# and the .github/workflows/hitl.yaml workflow discovers the `hitl`-tagged tests
# by query and `bazel test`s them against a real rig (timeout=eternal — a
# flash+provision cycle runs minutes). Still `bazel run`-able for a local one-off.
py_test(
    name = "e2e",
    timeout = "eternal",
    srcs = ["hitl_e2e.py"],
    # The firmware flash-bundle rides in runfiles so `bazel run` finds it without
    # a separate build step or a workspace-relative path (bazel run's cwd is the
    # runfiles tree). --bundle still overrides it for a prebuilt tar. The `hitl`
    # CLI also rides in runfiles: hitl_client shells out to it for the whole
    # reserve/flash/tunnel flow (default_hitl() resolves it there).
    data = [
        # The board-caps descriptor pins the BOARD CAPS phase to exactly what the
        # image embeds (loaded from runfiles as the expected value).
        "//firmware/player_app:board_caps.textproto",
        "//firmware/player_app:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_e2e.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# On-hardware LED-driver correctness test (logic-analyzer rig): reserve, flash,
# provision, drive a static counting pattern over the player WebSocket, then
# `hitl-capture` the WS2812 wire via the rig's shared FX2 and assert the decoded
# pixels match. Also verifies the configurable wire color order (FUG-123) as a
# folded-in phase — reconfigures channel 0 to non-default orders and asserts the
# DIN permutes as predicted (kept in this one target so the single analyzer rig
# isn't contended by a second one). Needs a logic-analyzer rig (Pi 3 + FX2 tapping
# the DUT's DIN), so it's manual+hitl like :e2e; the pattern/pixel + color-order
# contracts are unit-tested off hardware in //pi/hitl/tests:hitl_test
# (test_led_pattern.py, test_hardware_config_pattern.py). The `hitl-capture` tool
# itself is baked into the reservation container (nix/container.nix).
py_test(
    name = "led_capture",
    timeout = "eternal",
    srcs = ["hitl_led_capture.py"],
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        # The compiled JIT-bench effect for --jit-verify (FUG-134). The OPTIMIZED
        # .fxb the firmware ships, so it lowers to a native RV32 segment on-device.
        "//firmware/player_app:jit_bench_fxb_file",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_led_capture.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# FUG-134: the JIT-correctness sibling of :led_capture, the LED-wire analogue of
# the :fx_bench / :fx_bench_jit split. PR #114 shipped the on-device RV32IM JIT ON
# by default; this pins --jit-verify, which drives a JIT-able fx effect
# (jit_bench.fx) with the JIT OFF then ON on the SAME flashed firmware and asserts
# the captured WS2812 pixels are BIT-IDENTICAL — so the CI HITL lane proves the JIT
# renders identically to the interpreter on real silicon (a W^X/PMP/i-cache/codegen
# bug only manifests on the chip). Same analyzer rig + capture path as :led_capture.
py_test(
    name = "led_capture_jit",
    timeout = "eternal",
    srcs = ["hitl_led_capture.py"],
    args = ["--jit-verify"],
    data = [
        "//firmware/player_app:esp32c6_flashbundle",
        # The OPTIMIZED .fxb the firmware ships, so it lowers to a native RV32
        # segment on-device — the program under differential test.
        "//firmware/player_app:jit_bench_fxb_file",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_led_capture.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

