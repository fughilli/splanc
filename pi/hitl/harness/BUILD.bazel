# Pi -> spi_ws281x FPGA -> WS2812. Fans to any SKU with the spi-fpga + led-strip
# caps (the led-mapper-pi SKU — the FPGA is a per-DUT capability, not its own SKU);
# drives a known static frame over SPI and validates both the FPGA's WS2812 outputs
# (per port) and the raw SPI wire framing via the FX2 analyzer.
hitl_test(
    name = "fpga_ws281x",
    srcs = ["hitl_fpga_ws281x.py"],
    # The `hitl` CLI rides in runfiles so the reservation works without PATH setup
    # (default_hitl() resolves it there); mirrors :improv_e2e.
    data = ["@hitl_reserve//cmd/hitl"],
    main = "hitl_fpga_ws281x.py",
    requires = [
        "spi-fpga",
        "led-strip",
    ],
    deps = [
        ":harness",
        "//pi/led_driver",  # fpga_spi.encode_stream, for the raw-SPI cross-check
        "//pi/server",  # proto_wire: §7 flat-JSON <-> protobuf over the WS
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

