        requirement("websockets"),
    ],
)

# The FX debugger (docs/design/fx-debugger.md) on a real C6: pause, step one frame,
# and replay it on the host VM (//firmware/fx_vm:fx_replay) from the device's own
# snapshot — output, state and buffers must match BIT-EXACTLY (JIT on), one LED's
# re-run locals must match the host's, and a paused engine must auto-resume on a
# lapsed hold and on a disconnect. Pure verdict: fx_debug_core.
genrule(
    name = "fxdebug_fxbs",
    srcs = [
        "ab_demo/dbgFixed.fx",
        "ab_demo/dbgHue.fx",
        "ab_demo/dbgLoop.fx",
        "ab_demo/dbgTrail.fx",
    ],
    outs = [
        "dbgFixed.fxb",
        "dbgHue.fxb",
        "dbgLoop.fxb",
        "dbgTrail.fxb",
    ],
    cmd = " && ".join([
        "$(execpath //fx_compiler:fx_compile) $(location ab_demo/%s.fx) $(location %s.fxb)" % (n, n)
        for n in [
            "dbgFixed",
            "dbgHue",
            "dbgLoop",
            "dbgTrail",
        ]
    ]),
    tools = ["//fx_compiler:fx_compile"],
)

py_test(
