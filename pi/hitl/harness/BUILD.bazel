# Visual DUT identification: map each c6-<serial> to a physical board (hence to an
# analyzer channel) by flashing the minimal dut_id firmware (breathes the onboard
# WS2812 on GPIO8) DUT-by-DUT, stopping each blink over serial before the next.
# Interactive — run via `bazel run … -- --server http://<rig-ip>:8087`.
py_binary(
    name = "dut_id",
    srcs = ["hitl_dut_id.py"],
    data = [
        "//firmware/dut_id:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_dut_id.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "@rules_python//python/runfiles",
    ],
)

# Acquire the DUT→analyzer-channel map interactively: walk each DUT (blinking its
# onboard LED via dut_id), ask which analyzer channel it's wired to, then POST the
# map to the daemon (POST /analyzer/channel-map), which applies + persists it. Runs
# the dut_id blink helpers, so it shares that firmware bundle. Interactive — run via
# `bazel run … -- --server http://<rig-ip>:8087`.
py_binary(
    name = "map_la",
    srcs = [
        "hitl_dut_id.py",
        "hitl_map_la.py",
    ],
    data = [
        "//firmware/dut_id:esp32c6_flashbundle",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_map_la.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "@rules_python//python/runfiles",
    ],
)

# On-hardware mapping-sequence-trigger test (FUG-62): reserve a rig, flash,
# activate an effect, send start_mapping, and assert the device shows
# mapping-pattern frames (get_frame_timing ticks) — the regression guard for the
# render_once reorder that lets a capture preempt a resumed effect. Like :e2e /
# :fx_bench it's a manual+hitl py_test (needs a rig + board); the verdict logic
# (mapping_trigger_core) is unit-tested in //pi/hitl/tests. It
# reuses an .fx from the fx benchmarks (compiled via fx_compile) just to obtain a
# valid active effect, and rides the flash-bundle + hitl CLI in runfiles.
py_test(
    name = "mapping_trigger",
    timeout = "eternal",
    srcs = ["hitl_mapping.py"],
    data = [
        ":fx_benchmarks",
        "//firmware/player_app:esp32c6_flashbundle",
        "//fx_compiler:fx_compile",
        "//pi/hitl/cmd/hitl",
    ],
    imports = ["."],
    main = "hitl_mapping.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# The calibration micro-programs (FUG-11), as `.fx` source the harness compiles
# with fx_compile and runs on the real C6. Auto-generated from the web
# calibration source of truth (web/src/effects/calibrationBenchmarks.ts, via
# benchmarkExport.ts) so the in-browser and on-hardware runs measure the SAME
# programs; the drift test (//web:unit_tests) pins that. `*.heldout.fx` is the
# validation set the fit never sees. Every file compiles under //fx_compiler.
filegroup(
    name = "fx_benchmarks",
    srcs = glob(["benchmarks/*.fx"]),
)

# On-hardware FX benchmark (FUG-11): reserve a rig, flash, drive the calibration
# micro-programs on the real C6, and write a device-measurement bundle for the
# web builder to fit + validate into an authoritative cost profile. Like :e2e
# it's a manual+hitl py_test (needs a rig + board); the pure logic it depends on
# (fx_bench_core) is unit-tested in //pi/hitl/tests. --replay
# rebuilds a bundle from a recorded session with no hardware. The calibration
# `.fx` programs and the fx_compile CLI ride in runfiles so `bazel run` finds
# them without a workspace-relative path (default --benchmarks-dir/--fx-compile).
py_test(
    name = "fx_bench",
    timeout = "eternal",
    srcs = ["fx_bench.py"],
    data = [
        ":fx_benchmarks",
        "//firmware/player_app:esp32c6_flashbundle",
        "//fx_compiler:fx_compile",
        "//pi/hitl/cmd/hitl",
        # The unified golden (full bundle + margins), shared with the web
        # estimator test — the margin check reads it from runfiles.
        "//web:tests/testdata/device-bench-esp32c6.json",
    ],
    imports = ["."],
    main = "fx_bench.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

# FUG-125: the JIT-enabled sibling of :fx_bench. The shipped firmware runs the
# on-device JIT by DEFAULT, so :fx_bench pins it OFF (set_jit false) to keep
# checking the interpreter golden, and THIS target pins it ON (--jit) and checks
# the separate device-bench-esp32c6-jit.json golden. Same flashed firmware, same
# calibration corpus — only the runtime JIT differs, so the two lanes enforce the
# interpreter cost model and the JIT-accelerated cost model independently.
py_test(
    name = "fx_bench_jit",
    timeout = "eternal",
    srcs = ["fx_bench.py"],
    args = ["--jit"],
    data = [
        ":fx_benchmarks",
        "//firmware/player_app:esp32c6_flashbundle",
        "//fx_compiler:fx_compile",
        "//pi/hitl/cmd/hitl",
        # The JIT golden (JIT pinned ON); its interpreter twin is on :fx_bench.
        "//web:tests/testdata/device-bench-esp32c6-jit.json",
    ],
    imports = ["."],
    main = "fx_bench.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":harness",
        "//pi/server",
        "@rules_python//python/runfiles",
        requirement("websockets"),
    ],
)

