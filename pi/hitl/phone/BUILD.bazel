"""Phone-in-the-loop HITL station (FUG — drive the app over a WebSocket).

The app (loaded with ?driver=) connects back to `driver_server` and executes the
real user journeys on command; this station drives them and asserts on the app's
replies. Browser lane now (headless Chromium serving //web:dist); Android emulator
+ real-C6-via-rig lanes staged next. See pi/hitl/phone/README (plan) for phases.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "phone",
    srcs = [
        "android_ble_provision.py",
        "driver_server.py",
        "journey_runner.py",
        "launcher.py",
        "mock_device.py",
        "phone_target.py",
        "reservation_backend.py",
    ],
    data = glob(["journeys/*.json"]),
    imports = ["."],
    deps = [
        "//pi/hitl/harness",
        "//pi/server",
        requirement("websockets"),
    ],
)

py_binary(
    name = "phone_e2e",
    srcs = ["phone_e2e.py"],
    data = [
        "//firmware/player_app:esp32c6_netstack_flashbundle",
        # The phone-solver deployment (wasm + JS glue + worker), served at /solver/
        # like the real Pi server does — the deep mapping journey solves on-device.
        "//solver:solver_web",
        "//web:dist",
    ],
    env = {
        "HITL_BUNDLE_RUNFILE": "_main/firmware/player_app/esp32c6_netstack_flashbundle.tar",
    },
    imports = ["."],
    main = "phone_e2e.py",
    tags = [
        "hitl",
        "manual",
    ],
    deps = [
        ":phone",
        "@rules_python//python/runfiles",
        requirement("playwright"),
        requirement("websockets"),
    ],
)

# Automated Android phone-HITL journeys — the unattended CI rep on amd-rig's
# `android-phone` unit (real Samsung phone + real C6, :8088 phone daemon). Reserves
# the unit BY NAME on a PINNED server (tailnet discovery only reaches :8087), ships
# this harness + the web app + solver + netstack bundle into the env, flashes +
# provisions c6-a onto amd-rig-ap, puts the phone on the AP, and runs phone_e2e in-env
# (real Web-Bluetooth + cert-trust via adb/uiautomator). See android_journeys.py.
#
# Tagged `hitl_android` (NOT `hitl`): the CI lane's gating query is
# `attr(tags, "\bhitl\b", tests(//...))`, and the `_` keeps this OUT of that word-
# boundary match — so it never runs on every PR (only ONE android unit exists, which
# would bottleneck the fleet). The scheduled 6h run always includes it, and a PR opts
# in via the `hitl-android` label / a path-match / a `[hitl-android]` tag — the lane
# collects it with `attr(tags, "hitl_android", tests(//...))`. See .github/workflows/hitl.yaml.
py_test(
    name = "android_journeys",
    timeout = "eternal",  # reserve + flash + provision + 4 journeys runs many minutes
    srcs = ["android_journeys.py"],
    data = [
        "phone_e2e.py",  # the in-env entrypoint (shipped alongside :phone's modules)
        "//firmware/player_app:esp32c6_netstack_flashbundle",  # flashed onto c6-a
        "//solver:solver_web",  # on-device deep-mapping solve, served at /solver/
        "//web:dist",  # the LED Mapper app, served to the phone's Chrome
    ],
    imports = ["."],
    main = "android_journeys.py",
    tags = [
        "hitl_android",
        "manual",
    ],
    deps = [
        ":phone",  # phone_e2e's modules + journeys + //pi/hitl/harness (hitl_client/provision)
        "@rules_python//python/runfiles",
    ],
)

# Dry-run tests for the phone targets: assert each target's reachability model +
# command plan (adb/simctl/devicectl) WITHOUT hardware. Runs in CI/in-container.
py_test(
    name = "phone_target_test",
    srcs = ["phone_target_test.py"],
    imports = ["."],
    deps = [":phone"],
)

# Dry-run tests for the real-Android-BLE UI provisioner: the view-tree parse + the
# crowded-chooser disambiguation, on captured uiautomator XML. No hardware.
py_test(
    name = "android_ble_provision_test",
    srcs = ["android_ble_provision_test.py"],
    imports = ["."],
    deps = [":phone"],
)

# Software Improv BLE peripheral (Bumble) for the real-BLE lane — the app pairs with
# it over a real BLE stack instead of the app-seam virtual mock. Kept out of the core
# `phone` lib so only the real-BLE lane pulls the bumble dependency.
py_library(
    name = "ble_peripheral",
    srcs = ["ble_peripheral.py"],
    imports = ["."],
    deps = [requirement("bumble")],
)

# Real-GATT test: a Bumble central drives the full Improv handshake against the
# peripheral over a LocalLink (two full BLE stacks, no radio, no emulator).
py_test(
    name = "ble_peripheral_test",
    srcs = ["ble_peripheral_test.py"],
    imports = ["."],
    deps = [
        ":ble_peripheral",
        requirement("bumble"),
    ],
)

# Station runner: advertise the Improv peripheral on a real transport (the emulator's
# `android-netsim`, a host BlueZ adapter, or a RootCanal instance). Runs on the
# hypervisor station beside the booted emulator; the app pairs with it over real BLE.
#   bazel run //pi/hitl/phone:ble_peripheral_server -- --transport android-netsim --redirect http://<c6-ip>/
py_binary(
    name = "ble_peripheral_server",
    srcs = ["ble_peripheral.py"],
    imports = ["."],
    main = "ble_peripheral.py",
    tags = ["manual"],
    deps = [requirement("bumble")],
)

# adb / platform-tools from the pinned nixpkgs (@android_tools) — the Android lane's debug
# tool. Cross-platform: builds + runs on the aarch64 container AND the x86_64 station.
#   bazel build //pi/hitl/phone:adb  →  bazel-bin/.../adb (or the /nix/store path)
filegroup(
    name = "adb",
    srcs = ["@android_tools//:adb"],
)

# Android emulator + a native-ABI Google-APIs system image (Nix @android_emulator, from
# pi/hitl/phone/nix/android-emulator.nix). USE a macOS (Intel + Apple Silicon) or linux-x86_64
# station: those get the emulator from nixpkgs' upstream androidenv (no pin). aarch64-linux has
# a CUSTOM derivation for the CI emulator, but that source is DISCONTINUED upstream (the branch
# froze in 2025-03 and its artifacts are GC'd — nothing live to pin; see the nix file), so the
# arm64-linux target can't build today. The target stays compatible on macOS + Linux and
# INCOMPATIBLE (skipped) elsewhere (e.g. Windows).
# Also tagged `manual` so it stays out of `bazel build //...` (a multi-GB SDK download only the
# Android lane needs) — build it explicitly. On the station, point ANDROID_SDK_ROOT at the
# libexec/android-sdk/ tree in its output; launcher.py resolves adb + emulator + avdmanager
# from there. Acceleration needs the host hypervisor — Hypervisor.framework / /dev/kvm.
filegroup(
    name = "android_emulator",
    srcs = ["@android_emulator//:sdk"],
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
