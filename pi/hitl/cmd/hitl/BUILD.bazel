load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hitl_lib",
    srcs = ["main.go"],
    importpath = "github.com/fughilli/splanc/pi/hitl/cmd/hitl",
    visibility = ["//visibility:private"],
    deps = [
        "//pi/hitl/internal/api",
        "//pi/hitl/internal/pool",
        "//pi/hitl/internal/tailnet",
    ],
)

go_binary(
    name = "hitl",
    embed = [":hitl_lib"],
    visibility = ["//visibility:public"],
)

# Source files staged into the hermetic flake TreeArtifact (sbc_application
# flake_srcs) so `nix build` reads deterministic content, never the live
# workspace. Referenced by //pi/hitl:flake_srcs.
filegroup(
    name = "flake_srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//pi/hitl:__pkg__"],
)
