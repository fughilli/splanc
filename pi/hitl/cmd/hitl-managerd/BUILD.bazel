load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "hitl-managerd_lib",
    srcs = ["main.go"],
    importpath = "github.com/fughilli/splanc/pi/hitl/cmd/hitl-managerd",
    visibility = ["//visibility:private"],
    deps = [
        "//pi/hitl/internal/analyzer",
        "//pi/hitl/internal/ap",
        "//pi/hitl/internal/api",
        "//pi/hitl/internal/metrics",
        "//pi/hitl/internal/queue",
        "//pi/hitl/internal/runner",
    ],
)

go_binary(
    name = "hitl-managerd",
    embed = [":hitl-managerd_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "hitl-managerd_test",
    srcs = ["main_test.go"],
    embed = [":hitl-managerd_lib"],
    deps = [
        "//pi/hitl/internal/metrics",
        "//pi/hitl/internal/queue",
        "//pi/hitl/internal/runner",
    ],
)
