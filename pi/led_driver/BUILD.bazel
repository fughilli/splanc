"""pi/led_driver — the spi_ws281x FPGA SPI framing (`led_driver.fpga_spi`), kept as
the HITL harness's reference encoder for the raw-SPI cross-check
(//pi/hitl/harness:hitl_fpga_ws281x).

The Python M1 pattern driver (graycode/driver/control-socket/APA102 SPI) was
retired: the Pi runs the Rust player (//pi/player_rs) and the hue code has ONE
implementation, the Rust kernel //firmware/pattern.

`imports = ["."]` exposes the nested `led_driver/` package as `led_driver`.

@rr(PR-11): implemented in this package (see requirements/requirements.yaml)
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "led_driver",
    srcs = glob(["led_driver/*.py"]),
    imports = ["."],
)

py_test(
    name = "led_driver_test",
    srcs = [
        "tests/pytest_main.py",
        "tests/test_fpga_spi.py",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":led_driver",
        "@rules_requirements//python",
        requirement("pytest"),
    ],
)
