"""Fully-static aarch64-linux-musl build of the (100% Rust) Pi player. rustc
provides the musl crt + libc.a (self-contained); a minimal cc toolchain here
supplies rust-lld + `-static` and none of gcc's glibc defaults. Both the rust
and cc toolchains are constrained to `libc:musl`, so they bind ONLY this build —
never the gnu host/exec tool builds. Flows through the build graph as build_data.
"""

load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")
load(":transition.bzl", "static_musl_binary")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "libc")

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

platform(
    name = "aarch64_linux_musl",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":musl",
    ],
)

config_setting(
    name = "is_musl",
    constraint_values = [":musl"],
)

# --- rust toolchain (musl target), libc:musl-scoped ------------------------
toolchain(
    name = "musl_rust_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":musl",
    ],
    target_settings = ["@rules_rust//rust/toolchain/channel:stable"],
    toolchain = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

# --- cc toolchain (rust-lld linker, static), libc:musl-scoped ---------------
cc_toolchain_config(
    name = "musl_cc_config",
    linker = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
)

cc_toolchain(
    name = "musl_cc",
    all_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    ar_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    compiler_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    dwp_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    linker_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    objcopy_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    strip_files = "@rust_linux_aarch64__aarch64-unknown-linux-musl__stable_tools//:rust-lld",
    toolchain_config = ":musl_cc_config",
)

toolchain(
    name = "musl_cc_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":musl",
    ],
    toolchain = ":musl_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# The deploy's build_data target: builds //pi/player_rs:player under the musl
# platform (target-only transition; exec stays gnu). Pure Rust, so it
# cross-compiles on the macOS deploy host too — nothing staged.
static_musl_binary(
    name = "player_musl",
    src = "//pi/player_rs:player",
    target_platform = ":aarch64_linux_musl",
)
