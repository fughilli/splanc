"""LED Mapper — Raspberry Pi player app (Rust).

A native-Rust reimplementation of the Pi player (replacing pi/led_driver +
pi/server) that reuses the firmware Rust core (//firmware/player et al.) directly
as crate deps — no FFI — and adds the Pi platform layer. Builds for the host,
which on the aarch64 Pi is the deploy target triple; no ESP gate.

Phase 1: the wire-framing layer, a byte-exact port of the Python
led_driver/{fpga_spi,spi}.py, pinned by the same encoder vectors.
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "player_rs",
    srcs = [
        "src/clock.rs",
        "src/fx.rs",
        "src/gpio_cdev.rs",
        "src/health.rs",
        "src/http.rs",
        "src/lib.rs",
        "src/ota.rs",
        "src/output.rs",
        "src/pacing.rs",
        "src/pipeline.rs",
        "src/render.rs",
        "src/rt.rs",
        "src/schedule.rs",
        "src/server.rs",
        "src/session.rs",
        "src/spi_retry.rs",
        "src/triple.rs",
        "src/wire.rs",
    ],
    crate_name = "ledmapper_player_rs",
    edition = "2021",
    # The MAX output-thread modules (gpio_cdev.rs, pacing.rs, pipeline.rs, rt.rs:
    # the GPIO v2 uAPI, SCHED_FIFO / affinity, clock_nanosleep) are Linux-only and
    # compiled out elsewhere (#[cfg(target_os = "linux")] in lib.rs), so the
    # library and player_host still build on macOS.
    deps = [
        # The reused firmware session/pattern/effects core — host protobuf
        # profile (the Pi has RAM to spare), depended on directly (no FFI).
        # The effects VM + uniform manifest + map decoding the host player's
        # effects layer (src/fx.rs) runs: the same crates the device links.
        "//firmware/fx_vm",
        "//firmware/keypoint",
        "//firmware/ota",
        "//firmware/player",
        "//firmware/store",
        "@pbview",
        # Over-the-air updates (docs/design/max-ota.md): the offer check + the
        # updater's state/inbox formats.
        "//pi/max_ota",
        "//shared/protocol/rust:ledmapper_pb",
        "//shared/protocol/rust:ledmapper_view",
        "@crates//:micropb",
        # Output pacing: GPIO v2 uAPI ioctls, SCHED_FIFO, affinity, mlockall
        # (gpio_cdev.rs, pacing.rs, rt.rs). Already in the graph via tokio/spidev.
        "@player_crates//:libc",
        # Phase 3 WS+TLS transport (server.rs) — PURE RUST crypto (no ring/C).
        "@player_crates//:futures-util",
        "@player_crates//:p256",
        "@player_crates//:rustls",
        "@player_crates//:rustls-rustcrypto",
        "@player_crates//:tokio",
        "@player_crates//:tokio-rustls",
        "@player_crates//:tokio-tungstenite",
        "@player_crates//:x509-cert",
    ],
)

# The player binary: pure render library + the Linux spidev sink. Builds for the
# host, which on the aarch64 Pi IS the deploy triple.
rust_binary(
    name = "player",
    srcs = [
        "src/main.rs",
        "src/sink.rs",
    ],
    edition = "2021",
    # On the musl platform: rustc emits the self-contained musl crt + libc.a and
    # a static object; the //pi/player_rs/musl cc toolchain links it with rust-lld
    # + -static. No-op on the gnu host build.
    rustc_flags = select({
        "//pi/player_rs/musl:is_musl": [
            "-Ctarget-feature=+crt-static",
            "-Clink-self-contained=yes",
        ],
        "//conditions:default": [],
    }),
    # spidev + the Linux-only output-thread modules. The deploy builds it for the
    # aarch64-linux-musl platform (//pi/player_rs/musl), from macOS too; a native
    # macOS `bazel test //...` skips it.
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":player_rs",
        "//firmware/player",
        "@player_crates//:spidev",
        "@player_crates//:tokio",
    ],
)

# The player on a desktop host (macOS / Linux): the same WSS player + the
# effects layer, driving network LED controllers (DDP / Art-Net, src/output.rs)
# instead of SPI. See docs/host-player.md.
rust_binary(
    name = "player_host",
    srcs = ["src/host_main.rs"],
    edition = "2021",
    deps = [
        ":player_rs",
        "//firmware/fx_vm",
        "//firmware/player",
        "@player_crates//:tokio",
    ],
)

rust_test(
    name = "player_rs_test",
    crate = ":player_rs",
    edition = "2021",
    # Envelope structs carry inline heapless storage (see //shared/protocol/rust)
    # and land on the test thread's stack — same bump the firmware player tests use.
    env = {"RUST_MIN_STACK": "33554432"},
    # The effects layer's tests compile a real shader.
    deps = ["//fx_compiler"],
)

# The virtual LED wall as an addable player (docs/host-player.md "Virtual LED
# wall"): player_host with no LED output, serving web/wall.html on its WSS port so
# the wall renders the player's mapping pattern in the browser.
#   bazel run //pi/player_rs:wall -- --leds 400
py_binary(
    name = "wall",
    srcs = ["tools/wall.py"],
    data = [
        ":player_host",
        "//web:dist",
    ],
    main = "tools/wall.py",
    deps = [
        requirement("segno"),
        "@rules_python//python/runfiles",
    ],
)

# Headless end-to-end check of :wall (Playwright): the wall page loads from the
# player, follows a mapping the "phone" starts, and its canvas decodes frame by
# frame against the hue-code kernel on the player's clock. A bazel-run tool, not
# a test (it needs a browser):
#   bazel run //pi/player_rs:wall_smoke
py_binary(
    name = "wall_smoke",
    srcs = ["tools/wall_smoke.py"],
    data = [
        ":player_host",
        "//web:dist",
    ],
    main = "tools/wall_smoke.py",
    deps = [
        "//firmware/pattern:pattern_py",
        requirement("playwright"),
        requirement("websockets"),
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "wall_test",
    srcs = ["tools/wall_test.py"],
    main = "tools/wall_test.py",
    deps = [":wall_lib"],
)

py_library(
    name = "wall_lib",
    srcs = ["tools/wall.py"],
    imports = ["tools"],
)
