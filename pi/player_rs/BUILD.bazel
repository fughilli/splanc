"""LED Mapper — Raspberry Pi player app (Rust).

A native-Rust reimplementation of the Pi player (replacing pi/led_driver +
pi/server) that reuses the firmware Rust core (//firmware/player et al.) directly
as crate deps — no FFI — and adds the Pi platform layer. Builds for the host,
which on the aarch64 Pi is the deploy target triple; no ESP gate.

Phase 1: the wire-framing layer, a byte-exact port of the Python
led_driver/{fpga_spi,spi}.py, pinned by the same encoder vectors.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "player_rs",
    srcs = [
        "src/lib.rs",
        "src/render.rs",
        "src/server.rs",
        "src/session.rs",
        "src/wire.rs",
    ],
    crate_name = "ledmapper_player_rs",
    edition = "2021",
    deps = [
        # The reused firmware session/pattern/effects core — host protobuf
        # profile (the Pi has RAM to spare), depended on directly (no FFI).
        "//firmware/player",
        "//shared/protocol/rust:ledmapper_pb",
        "@crates//:micropb",
        # Phase 3 WS+TLS transport (server.rs) — PURE RUST crypto (no ring/C).
        "@crates//:futures-util",
        "@crates//:p256",
        "@crates//:rustls",
        "@crates//:rustls-rustcrypto",
        "@crates//:tokio",
        "@crates//:tokio-rustls",
        "@crates//:tokio-tungstenite",
        "@crates//:x509-cert",
    ],
)

# The player binary: pure render library + the Linux spidev sink. Builds for the
# host, which on the aarch64 Pi IS the deploy triple.
rust_binary(
    name = "player",
    srcs = [
        "src/main.rs",
        "src/sink.rs",
    ],
    edition = "2021",
    deps = [
        ":player_rs",
        "//firmware/player",
        "@crates//:spidev",
        "@crates//:tokio",
    ],
)

# The container-built (aarch64-linux-gnu) player binary, STAGED under dist/ for
# the deploy to ship as build_data. The binary can't be a normal build_data
# Bazel target (`:player`) because the deploy builds build_data on the macOS host
# -> a darwin binary; instead we build it natively in the aarch64-linux container
# (`bazel build //pi/player_rs:player && cp -L bazel-bin/.../player dist/player`)
# and the shared /workspace makes it visible to the host deploy. The Nix image
# autoPatchelfs it onto NixOS's glibc (2.40 >= the container's 2.39). dist/ is
# gitignored. TODO: replace with a static-musl build (no patchelf) once a musl cc
# toolchain is wired (see //pi/player_rs/musl plan in memory).
filegroup(
    name = "player_prebuilt",
    # glob (not a literal) so a fresh checkout without the staged binary doesn't
    # break `bazel build //...`; a deploy that forgot to stage gets a clear
    # "player binary missing from build_data" throw from apps.nix instead.
    srcs = glob(
        ["dist/*"],
        allow_empty = True,
    ),
)

rust_test(
    name = "player_rs_test",
    crate = ":player_rs",
    edition = "2021",
    # Envelope structs carry inline heapless storage (see //shared/protocol/rust)
    # and land on the test thread's stack — same bump the firmware player tests use.
    env = {"RUST_MIN_STACK": "16777216"},
)
