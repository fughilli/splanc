"""pi/server — M2. FastAPI/uvicorn web server + WebSocket control plane.

Serves the web app, runs the §7 WebSocket protocol, persists capture sessions to
a log M3 can consume, triggers reconstruction, and serves the resulting maps.
Library + CLI (`serve`).

`imports = ["."]` puts this directory on the import path so the nested
`server/` package is importable as `server` (and runnable as `python -m server`).



Requirements (PRs implemented here; see requirements/requirements.yaml): PR-11, PR-12, PR-13, PR-22, PR-31, PR-34
"""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "server",
    srcs = glob(["server/*.py"]),
    imports = ["."],
    deps = [
        "//pi/reconstruction",
        "//shared/protocol",
        "//shared/protocol/proto:ledmapper_py_proto",
        "@rules_python//python/runfiles",
        requirement("fastapi"),
        requirement("uvicorn"),
    ],
)

py_binary(
    name = "gen_proto_golden",
    srcs = ["gen_proto_golden.py"],
    imports = ["."],
    deps = [":server"],
)

py_binary(
    name = "serve",
    srcs = ["server/__main__.py"],
    # The native (Rust) solver rides in runfiles: pose-less final + interim
    # solves run it as a subprocess (server/native_solver.py). The _opt
    # wrapper transitions it to -c opt whatever mode this server builds in.
    data = ["//solver:solver_cli_opt"],
    imports = ["."],
    main = "server/__main__.py",
    deps = [":server"],
)

# Fast unit tests: code-book, session/map store, and the WebSocket message
# handler (with a stub reconstructor) — no socket, no solver.
py_test(
    name = "server_test",
    srcs = [
        "tests/pytest_main.py",
        "tests/test_codebook.py",
        "tests/test_debug.py",
        "tests/test_handler.py",
        "tests/test_proto_wire.py",
        "tests/test_session.py",
    ],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":server",
        "//shared/protocol",
        "//tools/traceability",
        requirement("pytest"),
    ],
)

# Integration test: boots a real uvicorn server, drives the full §7 flow over a
# real WebSocket using simulator detections, then reconstructs and serves the
# map over HTTP. Heavier (real solver) so kept separate from the unit suite.
py_test(
    name = "server_integration_test",
    srcs = [
        "tests/pytest_main.py",
        "tests/test_app_integration.py",
    ],
    data = ["//solver:solver_cli"],
    imports = ["."],
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":server",
        "//pi/reconstruction",
        "//shared/protocol",
        "//shared/simulator",
        "//tools/traceability",
        requirement("pytest"),
        requirement("scipy"),
        requirement("websockets"),
    ],
)
