          "refId": "A",
          "expr": "count by (reset_reason) (sum by (reset_reason, dev) (count_over_time({service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | reset_reason!=\"\" [$__range])))",
          "legendFormat": "{{reset_reason}}",
