          },
          "refId": "A",
          "expr": "sum(count_over_time({service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | fps_lagging=\"true\" [1h]))",
          "legendFormat": "lagging",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "B",
          "expr": "sum(count_over_time({service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | fps_lagging=\"false\" [1h]))",
          "legendFormat": "on rate",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
