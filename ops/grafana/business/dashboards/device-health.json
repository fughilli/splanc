    {
      "id": 11,
      "type": "timeseries",
      "title": "Achieved frame rate (p10 / p50 / p90 of samples)",
      "description": "fps_achieved: what the last ~30 frames really ran at.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "max(quantile_over_time(0.1, {service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | unwrap fps_achieved [1h]))",
          "legendFormat": "p10",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "B",
          "expr": "max(quantile_over_time(0.5, {service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | unwrap fps_achieved [1h]))",
          "legendFormat": "p50",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "C",
          "expr": "max(quantile_over_time(0.9, {service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | unwrap fps_achieved [1h]))",
          "legendFormat": "p90",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: fps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Samples with a lagging effect",
      "description": "An effect below its minimum (or pinned) frame rate keeps playing as fast as it can (never parked).",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
