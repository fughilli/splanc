          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Least free memory since boot (p10 / min)",
      "description": "heap_min_free: the low-water mark. The C6's TLS handshake needs ~8 KB contiguous.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "max(quantile_over_time(0.1, {service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | unwrap heap_min_free [1h]))",
          "legendFormat": "p10",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "B",
          "expr": "min(min_over_time({service=\"splanc-relay\", component=\"device-metrics\", env=~\"$env\", event=\"dm_device\"} | json | unwrap heap_min_free [1h]))",
          "legendFormat": "min",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
