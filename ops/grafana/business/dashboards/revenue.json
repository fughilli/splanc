{
  "uid": "splanc-biz-revenue",
  "title": "Splanc — Revenue & credits",
  "description": "AI credits sold and refunded (Apple + web/Stripe), fee estimates, the outstanding credit liability, and active paying accounts. Fees are estimates from the pricing config; net = gross - fee.",
  "tags": ["splanc-business", "private"],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5m", "15m", "1h", "6h"]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "description": "Which relay's events: production, sandbox (Stripe TEST mode), synthetic (made-up test data). Synthetic is never selected by default.",
        "query": "production,sandbox,synthetic",
        "multi": true,
        "includeAll": false,
        "current": {
          "text": ["production", "sandbox"],
          "value": ["production", "sandbox"]
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "sandbox",
            "value": "sandbox",
            "selected": true
          },
          {
            "text": "synthetic",
            "value": "synthetic",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "App releases",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "grafanacloud-infinity"
        },
        "target": {
          "refId": "Anno",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.github.com/repos/fughilli/splanc/releases?per_page=100",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "$[$match(tag_name, /^app-v/)]",
          "columns": [
            {
              "selector": "published_at",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "tag_name",
              "text": "title",
              "type": "string"
            }
          ]
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "time"
          },
          "title": {
            "source": "field",
            "value": "title"
          },
          "text": {
            "source": "field",
            "value": "title"
          }
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["splanc-business"],
      "asDropdown": true,
      "title": "Business dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Totals for the selected range",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gross revenue",
      "description": "Sum of credit-pack prices bought (first credit of each transaction; store retries excluded).",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({service=\"splanc-relay\", component=\"ai-billing\", env=~\"$env\", event=\"ai_purchase\"} | json | replay=\"false\" | unwrap usd_gross [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
