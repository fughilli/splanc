      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "topk(10, sum by (tool) (count_over_time({service=\"splanc-relay\", component=\"feedback\", env=~\"$env\", event=\"fb_received\"} | json | tool!=\"none\" [$__range])))",
          "legendFormat": "{{tool}}",
