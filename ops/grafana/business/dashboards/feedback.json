          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "count(sum by (signature) (count_over_time({service=\"splanc-relay\", component=\"feedback\", env=~\"$env\", event=\"fb_received\"} | json [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
