"""Private Grafana Cloud monitoring for Splanc's business side (docs/design/ops-grafana.md).

  alerts.json           alert rules as code (Loki/LogQL over the relay's ops events)
  dashboards/*.json     the four dashboards (generated by gen_dashboards.py; committed)
  sync.py               applies both to the private folder (`--dry-run` touches nothing)

The relay-side schema these must match is agent/relay/src/ops.ts, cross-checked
by //agent:ops_test.
"""

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Read by //agent:ops_test (every event / field a query names must exist).
# copy_to_bin: an action in //agent may only read bin-tree copies made here.
copy_to_bin(
    name = "grafana_json",
    srcs = ["alerts.json"] + glob(["dashboards/*.json"]),
)

py_test(
    name = "business_grafana_test",
    size = "small",
    srcs = [
        "gen_dashboards.py",
        "sync.py",
        "test_business_grafana.py",
    ],
    data = [":grafana_json"],
    main = "test_business_grafana.py",
)
