"""OSC → uniform bridge (FUG-121).

Receives OSC over UDP from any OSC source (TouchDesigner, Ableton, TouchOSC,
Max/MSP, …) and drives live shader uniforms on a `ledmapper.v1` fixture, reusing
the TouchDesigner plugin's protocol core (//tools/touchdesigner/core) — its
`Session::drive_uniforms` maps named channels onto uniform slots via the device's
own manifest. The OSC wire parser is hand-rolled (no crate dep, like the repo's
protobuf/WebSocket), so the pure parsing + address-mapping logic is host-testable
in :osc_bridge_test; end-to-end driving needs a real fixture on the LAN.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "osc_bridge_lib",
    srcs = [
        "src/lib.rs",
        "src/osc.rs",
    ],
    crate_name = "ledmapper_osc_bridge",
    edition = "2021",
    deps = ["//tools/touchdesigner/core:td_ledmapper"],
)

rust_binary(
    name = "osc_bridge",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":osc_bridge_lib",
        "//tools/touchdesigner/core:td_ledmapper",
    ],
)

rust_test(
    name = "osc_bridge_test",
    crate = ":osc_bridge_lib",
    edition = "2021",
)
