"""Bench tooling."""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "player_probe",
    srcs = ["player_probe.py"],
    deps = [
        "//pi/server",
        requirement("websockets"),
    ],
)

# Standalone CV trace sink — receives ?trace= dumps from the capture page,
# writes readable JSONL + PNG thumbnails, and hosts a pairing QR (segno).
py_binary(
    name = "trace_server",
    srcs = ["trace_server.py"],
    deps = [requirement("segno")],
)

# Host-side flash + serial-log helper. Run on the machine the board is plugged
# into (`bazel run //tools:flash_server`); drive it over HTTP from the
# container. It shells back out to `bazel` under $BUILD_WORKSPACE_DIRECTORY to
# run the flash target, and reads the serial console for logs. Stdlib-only
# (pyserial used if importable, else a termios fallback).
py_binary(
    name = "flash_server",
    srcs = ["flash_server.py"],
)

# Host-side Improv-BLE onboarding driver — provisions the player onto WiFi via a
# real Bluetooth radio (SimpleBLE), replacing the phone's Web Bluetooth step
# (which can't be automated). Run on the host: `bazel run //tools:ble_onboard_server`.
py_binary(
    name = "ble_onboard_server",
    srcs = ["ble_onboard_server.py"],
    deps = [requirement("simplepyble")],
)

# Host-side headless-browser driver — drives Chromium (Playwright) to exercise
# the player's wss + self-signed-cert flow. Run on the host: `bazel run
# //tools:browser_server`. NOTE: `playwright install chromium` once to fetch the
# browser binary (not a pip artifact).
py_binary(
    name = "browser_server",
    srcs = ["browser_server.py"],
    deps = [
        requirement("playwright"),
        requirement("segno"),  # QR page for the effects-intake URL
    ],
)
