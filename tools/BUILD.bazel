"""Bench tooling."""

load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

# Firmware static-RAM auditor: attributes every .data/.bss symbol in the esp32c6
# ELF back to its source TU, for hunting fat static buffers that starve the heap.
# Shells out to readelf/nm/addr2line — vendored from Nix (MODULE.bazel:
# binutils-unwrapped-all-targets) as `data` so it works on hosts with no binutils
# (e.g. macOS). The script globs its runfiles for the tools.
#   bazel build -c opt //firmware/player_app:esp32c6
#   bazel run //tools:fw_memaudit -- --json > mem.json
py_binary(
    name = "fw_memaudit",
    srcs = ["fw_memaudit.py"],
    data = ["@binutils-unwrapped-all-targets//:tools"],
    visibility = ["//visibility:public"],
    # Resolve the vendored binutils out of runfiles (manifest + repo-mapping aware).
    deps = ["@rules_python//python/runfiles"],
)

# Treeview + bar-chart renderer over `fw_memaudit --json`. Pure stdlib — no ELF
# or toolchain needed.
#   bazel run //tools:fw_memaudit -- --json | bazel run //tools:fw_memviz
py_binary(
    name = "fw_memviz",
    srcs = ["fw_memviz.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "player_probe",
    srcs = ["player_probe.py"],
    deps = [
        "//pi/server",
        requirement("websockets"),
    ],
)

# Package an esptool_flash launcher's images into one self-describing flash bundle
# (flash.json + bins). Stdlib only. Used by the `*_flashbundle` genrule.
py_binary(
    name = "mk_flashbundle",
    srcs = ["mk_flashbundle.py"],
    visibility = ["//visibility:public"],
)

# Stage flash bundle(s) into the web publish tree (<out>/<id>/ + manifest.json)
# so the webapp can flash boards over USB (FUG-60). Stdlib only; invoked from
# web/stage_site.lib.sh and web/serve.sh with the flashbundle tar in runfiles.
py_binary(
    name = "stage_firmware",
    srcs = ["stage_firmware.py"],
    visibility = ["//visibility:public"],
)

# Standalone CV trace sink — receives ?trace= dumps from the capture page,
# writes readable JSONL + PNG thumbnails, and hosts a pairing QR (segno).
py_binary(
    name = "trace_server",
    srcs = ["trace_server.py"],
    deps = [requirement("segno")],
)

# Host-side flash + serial-log helper. Run on the machine the board is plugged
# into (`bazel run //tools:flash_server`); drive it over HTTP from the
# container. It shells back out to `bazel` under $BUILD_WORKSPACE_DIRECTORY to
# run the flash target, and reads the serial console for logs. Stdlib-only
# (pyserial used if importable, else a termios fallback).
py_binary(
    name = "flash_server",
    srcs = ["flash_server.py"],
)

# Host-side Capacitor/Xcode build helper for the Splanc iOS wrapper (FUG-92).
# Xcode/CocoaPods/Simulator only exist on the macOS host, so run this there
# (`bazel run //tools:ios_build_server`, or `python3 tools/ios_build_server.py`)
# and drive it from the container with `tools/iosctl`. Stdlib-only; it shells
# out to the host's node/pnpm/cap/xcodebuild for an allowlisted set of tasks.
py_binary(
    name = "ios_build_server",
    srcs = ["ios_build_server.py"],
)

# Host-side Improv-BLE onboarding driver — provisions the player onto WiFi via a
# real Bluetooth radio (SimpleBLE), replacing the phone's Web Bluetooth step
# (which can't be automated). Run on the host: `bazel run //tools:ble_onboard_server`.
py_binary(
    name = "ble_onboard_server",
    srcs = ["ble_onboard_server.py"],
    deps = [requirement("simplepyble")],
)

# Host-side headless-browser driver — drives Chromium (Playwright) to exercise
# the player's wss + self-signed-cert flow. Run on the host: `bazel run
# //tools:browser_server`. NOTE: `playwright install chromium` once to fetch the
# browser binary (not a pip artifact).
py_binary(
    name = "browser_server",
    srcs = ["browser_server.py"],
    deps = [
        requirement("playwright"),
        requirement("segno"),  # QR page for the effects-intake URL
    ],
)
