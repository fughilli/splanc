"""tools/vive/pose_server — lhd behind a three.js viewer and an SSE pose stream.

`bazel run -c opt //tools/vive/pose_server -- --no-open` serves http://127.0.0.1:8765
with lhd (`@lighthouse//daemon:lhd`, from fughilli/lighthouse) reading the Watchman
dongle or a wired tracker. Every demo in tools/vive/demos reads its poses here.
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "pose_server",
    srcs = ["server.py"],
    args = [
        "--lhd",
        "$(rootpath @lighthouse//daemon:lhd)",
    ],
    data = [
        "index.html",
        "@lighthouse//daemon:lhd",
    ],
    main = "server.py",
)

py_test(
    name = "server_test",
    srcs = [
        "server.py",
        "tests/test_server.py",
    ],
    data = ["index.html"],
    main = "tests/test_server.py",
)
