"""Native VIO solver (Rust) — one crate, two deployments.

  :solver            the library (unit-tested port of reconstruction/vio*.py)
  :solver_cli        host binary the Pi server runs as a subprocess
  :solver_wasm       wasm32 cdylib with wasm-bindgen exports for the phone
  :solver_wasm_pkg   wasm-bindgen JS glue + .wasm, served under /solver/
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

SRCS = glob(["src/**/*.rs"])

rust_library(
    name = "solver",
    srcs = SRCS,
    crate_name = "ledmapper_solver",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "solver_test",
    crate = ":solver",
    edition = "2021",
)

rust_binary(
    name = "solver_cli",
    srcs = ["bin/solver_cli.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":solver",
        "@crates//:serde_json",
    ],
)

# The wasm build is a thin cdylib of #[wasm_bindgen] exports over :solver.
# rust_wasm_bindgen's platform transition builds the whole dep tree for
# wasm32-unknown-unknown.
rust_shared_library(
    name = "solver_wasm",
    srcs = ["bin/wasm_lib.rs"],
    edition = "2021",
    deps = [
        ":solver",
        "@crates//:js-sys",
        "@crates//:serde_json",
        "@crates//:wasm-bindgen",
    ],
)

rust_wasm_bindgen(
    name = "solver_wasm_pkg",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":solver_wasm",
)

# The complete phone-side solver deployment: wasm + JS glue + the worker
# that hosts them off the main thread. Served by the Pi server at /solver/
# (app.py --solver-dir, via runfiles — see web/serve.sh).
copy_to_directory(
    name = "solver_web",
    srcs = [
        "worker.js",
        ":solver_wasm_pkg",
    ],
    replace_prefixes = {"solver_wasm_pkg": ""},
    visibility = ["//visibility:public"],
)
