// Tang Nano 9K (GW1NR-9C) pin constraints for spi_ws281x.
// 27 MHz onboard crystal.
IO_LOC "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// SPI slave (from the host / Pi). Header GPIO.
IO_LOC "ss" 25;
IO_PORT "ss" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sck" 26;
IO_PORT "sck" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "mosi" 27;
IO_PORT "mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// WS281x outputs (8 header GPIO, pins 70-77).
IO_LOC "ws[0]" 70;
IO_PORT "ws[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[1]" 71;
IO_PORT "ws[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[2]" 72;
IO_PORT "ws[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[3]" 73;
IO_PORT "ws[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[4]" 74;
IO_PORT "ws[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[5]" 75;
IO_PORT "ws[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[6]" 76;
IO_PORT "ws[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ws[7]" 77;
IO_PORT "ws[7]" IO_TYPE=LVCMOS33 DRIVE=8;

// 6 onboard user LEDs (active low) — frame-activity bounce animation.
IO_LOC "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
