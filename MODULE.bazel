"""LED Mapper — Bazel module (bzlmod).

Polyglot repo: Python (Pi server, reconstruction, simulator, protocol codegen)
and TypeScript (web app, generated protocol types).

All dependency versions are pinned. The decision log in `docs/decisions.md`
records why these specific versions were chosen and the date they were pinned.
Update both this file and the decision log together.
"""

module(
    name = "led_mapper",
    version = "0.0.0",
    compatibility_level = 1,
)

# ---------------------------------------------------------------------------
# Core language rules
# ---------------------------------------------------------------------------

bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.11")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# buildifier-lint's modern-loads fix rewrites native sh_binary to the
# rules_shell load; the dep makes that rewrite real.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Same story for cc_* (firmware/player_app): the per-rule .bzl files
# (cc/cc_binary.bzl, ...) need a modern rules_cc.
bazel_dep(name = "rules_cc", version = "0.2.22")

# Wire protocol (proto-comms): prebuilt protoc toolchain — Python bindings
# are generated at build time (no from-source protobuf compile, no checked-in
# _pb2.py); the runtime comes from pip (`protobuf`).
bazel_dep(name = "toolchains_protoc", version = "0.6.1")
bazel_dep(name = "rules_proto", version = "7.1.0")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v29.3",
)
use_repo(
    protoc,
    protoc_linux_aarch64 = "toolchains_protoc_hub.linux_aarch_64",
    protoc_linux_x86_64 = "toolchains_protoc_hub.linux_x86_64",
    protoc_osx_aarch64 = "toolchains_protoc_hub.osx_aarch_64",
    protoc_osx_x86_64 = "toolchains_protoc_hub.osx_x86_64",
)

# ---------------------------------------------------------------------------
# Go — the HITL rig daemon + CLI (pi/hitl/cmd, pi/hitl/internal/*). The Nix
# flake still builds the shipped binaries; these rules let the same packages
# build + TEST under Bazel (e.g. the queue reaper regression test). go.mod is
# stdlib-only (no `require`s), so no gazelle go_deps extension is needed — just
# a hermetic Go SDK. gazelle maintains the per-package BUILD files:
#   bazel run //pi/hitl:gazelle
# ---------------------------------------------------------------------------

bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.0")

# ---------------------------------------------------------------------------
# Rust — the native solver (solver/), built twice: host binary for the Pi
# server (subprocess via runfiles) and wasm32 + wasm-bindgen for the phone.
# The bare-metal triples serve the vendored firmware module (below): rules_rust
# merges toolchain requests root-module-first, so the ROOT declares the union.
# ---------------------------------------------------------------------------

bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.71.3")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "wasm32-unknown-unknown",  # phone solver
        "riscv32imac-unknown-none-elf",  # ESP32-C6
        "thumbv8m.main-none-eabi",  # RP2350 (soft-float ABI; see firmware)
    ],
    # Pinned to the version the vendored firmware validated on-device.
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1",
)
crate.spec(
    package = "serde_json",
    version = "1",
)

# Pinned EXACTLY to rules_rust_wasm_bindgen's bundled CLI version — the
# generated bindings' ABI schema must match the CLI that post-processes them.
crate.spec(
    package = "wasm-bindgen",
    version = "=0.2.121",
)
crate.spec(
    package = "js-sys",
    version = "0.3",
)

# Firmware protocol deps (docs/esp32-led-mapping-plan.md Phase 0b): no_std
# protobuf + fixed-capacity containers for the ESP32-C6 target. No std/alloc
# features; enable-64bit is required (CodeParams/solver fields are doubles);
# container-heapless binds repeated/string fields to heapless 0.8. The 0.5
# line is the newest whose generator builds on the firmware-validated rustc
# 1.85.0 (micropb-gen 0.6 needs let-chains, MSRV 1.88).
crate.spec(
    default_features = False,
    features = [
        "encode",
        "decode",
        "enable-64bit",
        "container-heapless",
    ],
    package = "micropb",
    version = "0.5.1",
)

# 0.8 line: 0.9 requires a newer rustc than the firmware-validated 1.85.0
# (core::ffi::FromBytesWithNulError changed shape), and 0.8 is what the
# embedded ecosystem (and micropb's container-heapless) target.
crate.spec(
    default_features = False,
    package = "heapless",
    version = "0.8",
)

# Test-only: the Rust leg of the cross-language proto conformance test reads
# web/tests/golden_proto_frames.json (base64 frames).
crate.spec(
    package = "base64",
    version = "0.22",
)
crate.from_specs(
    # rules_rust's default list is a small host-centric subset (splicing is
    # O(N^2) per triple) — it must be restated here to EXTEND it with the
    # bare-metal firmware triples, or @crates//:* are marked incompatible
    # with the @embedded platforms.
    supported_platform_triples = [
        # rules_rust defaults (SUPPORTED_PLATFORM_TRIPLES).
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
        # Firmware targets (docs/esp32-led-mapping-plan.md Phase 0b).
        "riscv32imac-unknown-none-elf",  # ESP32-C6
        "thumbv8m.main-none-eabi",  # RP2350
    ],
)
use_repo(crate, "crates")

# HOST-side code generator for micropb (build tool, not a firmware dep):
# invoked by //shared/protocol/rust to turn ledmapper.proto into no_std Rust.
# Version-locked to the micropb runtime line above. ISOLATED universe: the
# generator needs micropb WITH the std feature, and crate_universe unifies
# features per crate across a universe — sharing one universe would leak std
# onto the firmware micropb and break the riscv32imac-none build.
host_crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    isolate = True,
)
host_crate.spec(
    package = "micropb-gen",
    version = "0.5.1",
)
host_crate.from_specs(name = "host_crates")
use_repo(host_crate, "host_crates")

# ---------------------------------------------------------------------------
# ESP32-C6/RP2350 firmware monorepo (docs/esp32-led-mapping-plan.md Phase 0a):
# fetched directly from GitHub as a Bazel module (repo name @embedded).
# Its toolchains + Arduino cores come from Nix (the container/host has nix).
# ---------------------------------------------------------------------------

# sbc-deploy — the reusable Bazel+Nix single-board-computer deploy framework,
# extracted from this repo's pi/provisioning and developed standalone
# (github.com/fughilli/sbc-deploy). Consumed here for the Pi image/deploy
# targets (//pi/provisioning:ledmapper.*). Provides the `sbc_application` macro
# (deploy/defs.bzl) + `lib.mkSbcProject` (nix/flake.nix). git_override keeps the
# build self-contained (no local checkout needed); bump the commit to update.
# The Nix side is pinned in parallel by pi/provisioning/nix/flake.lock — bump
# both together (bazel commit + `nix flake update` in pi/provisioning/nix).
# For co-developing sbc-deploy locally: bazel --override_module=sbc_deploy=/path
# and, on the Nix side, --override-input sbc-deploy path:/path/nix.
bazel_dep(name = "sbc_deploy", version = "0.0.0")
git_override(
    module_name = "sbc_deploy",
    commit = "36d01f1ed361163b8eff4e022b8a99657fa8196b",
    remote = "https://github.com/fughilli/sbc-deploy.git",
)

bazel_dep(name = "firmware", version = "0.0.0", repo_name = "embedded")
archive_override(
    module_name = "firmware",
    # embedded master @569102d — the mbedtls-8k-record-and-selfsigned-cert work
    # merged: mbedtls 3.6.5 + IDF v5.5.4 built FROM SOURCE with
    # CONFIG_MBEDTLS_DYNAMIC_BUFFER (TLS record buffer 16 KB -> 8 KB, fixes the
    # C6's fragmented-heap wss/cert handshake OOM) + //libs/tls:selfsigned
    # (on-device SAN-cert re-issuance). Includes the x86_64-linux riscv/xtensa
    # toolchain hashes (were fakeHash → CI hash mismatch) + the embedded CI.
    # (569102d is e37969f with a commit-message-only rewrite; identical tree.)
    integrity = "sha256-7Ueh/m+aZh+HszxgLoBTcTbKyiGKN1jMTOY19XjrASc=",
    strip_prefix = "embedded-569102d541664d790fc708206f450dce477ca220",
    urls = ["https://github.com/fughilli/embedded/archive/569102d541664d790fc708206f450dce477ca220.tar.gz"],
)

# ---------------------------------------------------------------------------
# Nix integration.
#
# `nix` is a SYSTEM REQUIREMENT for this repository (README prerequisites):
# rules_nixpkgs imports Nix-built tools/packages as Bazel targets, the M4
# provisioning targets (//pi/provisioning:*) shell out to the `nix` CLI, and
# build tools like the HTML minifier (//tools/html:minify) come from the
# pinned nixpkgs snapshot below. Repository fetches are still lazy (a nixpkgs
# package is realized only when a target that uses it is built), so an
# unrelated `bazel build //some:target` needn't pay for nix it doesn't touch
# — but the repo as a whole (`bazel test //...`) does require `nix` on PATH,
# and that is intended, not a regression to work around.
#
# rules_nixpkgs 0.13.0 (pinned 2026-06-19). bzlmod module: rules_nixpkgs_core.
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

# Pinned nixpkgs snapshot (release tag 25.05, pinned 2026-07-13) — the source
# for Nix-provided build tools. sha256 is of the GitHub archive tarball.
nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.github(
    name = "nixpkgs",
    org = "NixOS",
    repo = "nixpkgs",
    sha256 = "130b4257b3d53bfbfea6d61fb76d4751a3989a4a09a28615ff77516a82b3924d",
    tag = "25.05",
)
use_repo(nix_repo, "nixpkgs")

# tdewolff/minify — a single static Go binary that minifies HTML/CSS/JS; the
# tool behind //tools/html:minify (html_minify rule) for resources baked into
# firmware flash (every byte served from the ESP32 counts).
nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.attr(
    attr = "minify",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "minify",
    srcs = ["bin/minify"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "minify")

# ---------------------------------------------------------------------------
# Python toolchain — Pi-compatible 3.11.
# rules_python provides a hermetic interpreter, so a system Python is not
# required for the build.
# ---------------------------------------------------------------------------

PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# ---------------------------------------------------------------------------
# pip dependencies — single root-level lockfile drives the whole repo.
# Regenerate with:  bazel run //:requirements.update
# ---------------------------------------------------------------------------

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "pypi")

# ---------------------------------------------------------------------------
# npm / pnpm — the single pnpm workspace covers web/ and shared/protocol/ts/.
# ---------------------------------------------------------------------------

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# TypeScript compiler version. Kept aligned with package.json devDependencies.
rules_ts_ext = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "ext",
    dev_dependency = True,
)
rules_ts_ext.deps(
    ts_version_from = "//:package.json",
)
use_repo(rules_ts_ext, "npm_typescript")
