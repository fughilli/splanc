{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splanc/requirements.schema.json",
  "title": "splanc requirements model",
  "description": "Machine-readable UN/PR/RISK model for the requirements-driven-development workflow. Shape only; referential integrity (satisfies/mitigates/mitigated_by) is enforced by //requirements:requirements_valid_test.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_needs", "product_requirements", "risks"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Free-form provenance/metadata; `source` is shown in the report."
    },
    "user_needs": {
      "type": "array",
      "items": { "$ref": "#/$defs/userNeed" }
    },
    "product_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    }
  },
  "$defs": {
    "userNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^UN-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^PR-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["direct", "derived"], "default": "direct" },
        "satisfies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^UN-\\d+$" }
        },
        "mitigates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RISK-\\d+$" }
        },
        "modules": { "type": "array", "items": { "type": "string" } },
        "verified_by": {
          "type": "array",
          "description": "Bazel test target labels that verify this PR at target granularity.",
          "items": { "type": "string" }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "default": "medium"
        },
        "mitigated_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^PR-\\d+$" }
        }
      }
    }
  }
}
