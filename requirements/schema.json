{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splanc/requirements.schema.json",
  "title": "splanc requirements model",
  "description": "Machine-readable UN/PR/RISK model for the requirements-driven-development workflow. Shape only; referential integrity (satisfies/mitigates/mitigated_by) is enforced by //requirements:requirements_valid_test.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_needs", "product_requirements", "risks"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Free-form provenance/metadata; `source` is shown in the report."
    },
    "user_needs": {
      "type": "array",
      "items": { "$ref": "#/$defs/userNeed" }
    },
    "product_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    }
  },
  "$defs": {
    "userNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^UN-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^PR-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["direct", "derived"], "default": "direct" },
        "method": {
          "type": "string",
          "description": "Demanded verification rigor. Ordered analysis<simulation<sil<hil<hitl, plus non-ordered inspection. Missing defaults to simulation.",
          "enum": ["analysis", "simulation", "sil", "hil", "hitl", "inspection"],
          "default": "simulation"
        },
        "satisfies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^UN-\\d+$" }
        },
        "mitigates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RISK-\\d+$" }
        },
        "modules": { "type": "array", "items": { "type": "string" } },
        "verified_by": {
          "type": "array",
          "description": "Bazel test targets that verify this PR at target granularity. Each item is either a bare label string (provides the default rigor) or a {target, level} mapping declaring the rigor that target provides.",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["target"],
                "properties": {
                  "target": { "type": "string" },
                  "level": {
                    "type": "string",
                    "enum": ["analysis", "simulation", "sil", "hil", "hitl", "inspection"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-\\d+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "default": "medium"
        },
        "likelihood": {
          "type": "string",
          "description": "Ordinal likelihood of the failure mode.",
          "enum": ["rare", "unlikely", "possible", "likely", "certain"]
        },
        "residual": {
          "type": "string",
          "description": "Risk remaining after mitigation (free-form note or level)."
        },
        "mitigated_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^PR-\\d+$" }
        }
      }
    }
  }
}
