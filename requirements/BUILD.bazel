"""requirements/ — the machine-readable requirements & risk model (FUG-89).

@rr(PR-23, PR-25): the model, its validation test and the annotation check.

Tooling comes from rules_requirements; see docs/requirements-driven-development.md.
"""

load("@rules_requirements//rr:defs.bzl", "rr_annotations_check", "rr_model")

package(default_visibility = ["//visibility:public"])

# `//requirements:model_test` validates structure, references and coverage rules.
rr_model(
    name = "model",
    srcs = ["requirements.yaml"],
)

# `bazel run //requirements:check_annotations` — fail on any @rr(...) /
# @pytest.mark.requirements(...) annotation in the tree naming an unknown id.
rr_annotations_check(
    name = "check_annotations",
    model = ":model",
)
