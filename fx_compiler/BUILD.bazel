"""Effects compiler (docs/design/effects-compiler.md): GLSL-ish source → .fxb
bytecode + uniform manifest for the fx_vm interpreter. Host + wasm (the browser
editor compiles live). Tests compile real shaders and run them through the
actual fx_vm, so the source→bytecode→VM pipeline is verified end-to-end.

@rr(PR-17, PR-27): implemented in this package (see requirements/requirements.yaml)
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//tools/transitions:opt.bzl", "opt_files")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fx_compiler",
    srcs = [
        "src/lib.rs",
        "src/lint.rs",
        "src/memo.rs",
        "src/opt.rs",
    ],
    crate_name = "ledmapper_fx_compiler",
    edition = "2021",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "fx_compile",
    srcs = ["bin/compile_main.rs"],
    edition = "2021",
    deps = [":fx_compiler"],
)

rust_test(
    name = "fx_compiler_test",
    srcs = ["tests/compile.rs"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# Perf warnings (float literal in fixed maths, pow(x, 2.0), ...).
rust_test(
    name = "warnings_test",
    srcs = ["tests/warnings.rs"],
    edition = "2021",
    deps = [":fx_compiler"],
)

# FUG-107 sensor drivers: export / poll() / i2c intrinsics, FLAG_DRIVER .fxb,
# and the MPU-6050 driver program against a register-file bus.
rust_test(
    name = "driver_test",
    srcs = ["tests/driver.rs"],
    compile_data = ["//firmware/sensor:drivers/mpu6050.fx"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# The uniform manifest an agent reads: doc strings, ranges, units, and the .fxb
# format version the device checks.
rust_test(
    name = "manifest_test",
    srcs = ["tests/manifest.rs"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
        "//firmware/osc",
        "@crates//:serde_json",
    ],
)

# FUG-125: differential + hill-climb harness for the bytecode optimizer.
# #400 signed/vector uniform ranges + mat3/mat4 (lowered to vecN ops): grammar,
# manifest, and VM equivalence against hand-written dot forms.
rust_test(
    name = "matrix_test",
    srcs = ["tests/matrix.rs"],
    compile_data = ["//agent:skill/examples/plane_slice_pose.fx"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
        "//firmware/osc",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "optimizer_test",
    srcs = ["tests/optimizer.rs"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# Variance analysis + per-frame hoisting + per-LED memoization: classification,
# cache selection under budget, and cached-vs-uncached bit-identity in the VM.
rust_test(
    name = "memo_test",
    srcs = ["tests/memo.rs"],
    compile_data = ["tests/testdata/rain.fx"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# Rate controls: the `time * uniform` phase lint (src/lint.rs) and that the
# integrator idiom it recommends stays continuous in the VM across a uniform
# change (memo pass + LED cache on), where `fract(time * speed)` jumps.
rust_test(
    name = "integrator_test",
    srcs = ["tests/integrator.rs"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# The Halloween play-mode effect pack (web/src/halloween/presets.ts): every
# preset compiles warning-free and renders (never all-black) on the real VM.
rust_test(
    name = "halloween_presets_test",
    srcs = ["tests/halloween_presets.rs"],
    compile_data = ["//web:src/halloween/presets.ts"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "//firmware/fx_vm",
    ],
)

# Browser: compile scripts live in the editor.
rust_shared_library(
    name = "fx_compiler_wasm",
    srcs = ["bin/wasm_lib.rs"],
    edition = "2021",
    deps = [
        ":fx_compiler",
        "@crates//:wasm-bindgen",
    ],
)

rust_wasm_bindgen(
    name = "fx_compiler_wasm_pkg",
    target = "web",
    wasm_file = ":fx_compiler_wasm",
)

opt_files(
    name = "fx_compiler_wasm_pkg_opt",
    srcs = [":fx_compiler_wasm_pkg"],
)

copy_to_directory(
    name = "fx_compiler_web",
    srcs = [":fx_compiler_wasm_pkg_opt"],
    replace_prefixes = {"fx_compiler_wasm_pkg": ""},
)
