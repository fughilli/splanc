# wifi_tx_driver — M1b: first transmit via our descriptor+PLCP0 (clone-and-replay).
cc_binary(
    name = "wifi_tx_driver",
    srcs = ["examples/wifi_tx_driver.cpp"],
    copts = ["-fno-rtti"],
    target_compatible_with = _C6,
    deps = _arduino + ["@embedded//libs/vendor:wifi"],
