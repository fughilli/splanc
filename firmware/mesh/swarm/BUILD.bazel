"""swarm_net, ported from fughilli/indoor_localization (swarm/net + swarm/proto at
5a906e78; PROVENANCE.md): mesh packets with managed flooding, authenticated live settings,
signed firmware manifests and page-by-page distribution. no_std, no allocation; every format
is a swarm.v1 message (//shared/protocol/proto:swarm_wire.proto) read with pbview views and
built with pbview's typed encoders (@pbview), bounded by proto/swarm_wire_bounds.txt.

Two builds of the same sources, differing only in the crypto backend (src/crypto.rs):
  :swarm_net     host (tests, tools): splanc_ota's SHA-256, HMAC on it, p256 from the
                 host-only @player_crates universe (as the OTA signer).
  :swarm_net_fw  firmware (C6 riscv32imac, P4 riscv32imafc): extern "C" MbedTLS shim
                 (:swarm_crypto) that the image links.
The Splanc layer on top (backhaul seam, link frame, node) is //firmware/mesh.
"""

load("@pbview//:defs.bzl", "pbview_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Host-only targets (their crypto crates are not in the firmware universes).
_HOST_ONLY = select({
    "@platforms//os:none": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

genrule(
    name = "swarm_wire_fdset",
    srcs = ["//shared/protocol/proto:swarm_wire.proto"],
    outs = ["swarm_wire.fdset.bin"],
    cmd = "$(execpath //tools/toolchains:protoc) -I $$(dirname $(location //shared/protocol/proto:swarm_wire.proto)) --descriptor_set_out=$@ $(location //shared/protocol/proto:swarm_wire.proto)",
    tools = ["//tools/toolchains:protoc"],
)

# Zero-copy views of swarm.v1 + typed encoders (FooEnc, MAX_ENCODED_LEN from the bounds).
pbview_library(
    name = "swarm_wire_rs",
    bounds = "proto/swarm_wire_bounds.txt",
    crate_name = "swarm_wire_rs",
    fdset = ":swarm_wire_fdset",
)

exports_files(["proto/testdata/swarm_wire_golden.txt"])

SRCS = glob(["src/*.rs"])

rust_library(
    name = "swarm_net",
    srcs = SRCS,
    # Host builds (tests, meshsim, Pi nodes) carry the custodian spill, the firmware image
    # updater (OTA over the mesh is Phase 2) and swarm settings bundles; the C6 firmware
    # carries none of them (mesh M6: effects travel as Splanc blobs,
    # firmware/mesh/src/blob.rs; Splanc firmware has no swarm bundle key).
    crate_features = [
        "custodian_spill",
        "fw_update",
        "swarm_settings",
    ],
    crate_root = "src/lib.rs",
    edition = "2021",
    target_compatible_with = _HOST_ONLY,
    deps = [
        ":swarm_wire_rs",
        "//firmware/ota",
        "@pbview",
        "@player_crates//:p256",
    ],
)

rust_test(
    name = "swarm_net_test",
    size = "small",
    crate = ":swarm_net",
    crate_features = [
        "custodian_spill",
        "fw_update",
        "swarm_settings",
    ],
    data = ["proto/testdata/swarm_wire_golden.txt"],
    edition = "2021",
    env = {"SWARM_WIRE_GOLDEN": "$(rootpath proto/testdata/swarm_wire_golden.txt)"},
)

rust_library(
    name = "swarm_net_fw",
    srcs = SRCS,
    crate_features = ["mbedtls"],
    crate_name = "swarm_net",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        ":swarm_wire_rs",
        "@pbview",
    ],
)

# The MbedTLS backend :swarm_net_fw calls (SHA-256 on the SHA accelerator, HMAC, P-256
# verify) and its boot self-test. Linked by the first image that carries the mesh (M3).
cc_library(
    name = "swarm_crypto",
    srcs = ["swarm_crypto.cpp"],
    hdrs = ["swarm_crypto.h"],
    copts = ["-fno-rtti"],
    include_prefix = "firmware/mesh/swarm",
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "@embedded//platforms:is_esp32c3": [],
        "@embedded//platforms:is_esp32p4": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@embedded//libs/board:arduino_core"],
)

# The golden vectors are exactly what the independent encoder (proto/gen_golden.py) prints.
py_test(
    name = "golden_fresh_test",
    size = "small",
    srcs = ["proto/golden_fresh_test.py"],
    data = [
        "proto/gen_golden.py",
        "proto/testdata/swarm_wire_golden.txt",
    ],
    env = {
        "GEN_GOLDEN": "$(rootpath proto/gen_golden.py)",
        "SWARM_WIRE_GOLDEN": "$(rootpath proto/testdata/swarm_wire_golden.txt)",
    },
    target_compatible_with = _HOST_ONLY,
)
