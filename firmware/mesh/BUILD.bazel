"""Splanc mesh (docs/design/mesh.md): the Splanc layer over the ported swarm stack
(//firmware/mesh/swarm). M1: the backhaul seam (Backhaul trait, RxMeta), the link frame
Splanc backhauls carry, and a Node that drives swarm_net over one backhaul with the mesh
payload sized from the backhaul's MTU. M2: the security envelope (AES-CCM on the netstack's
ccmp.rs, 64-bit counters, replay windows), insider-resistant admin sessions, ports,
membership and key rotation. no_std, no allocation.

  :mesh     host (tests): feature `host` adds the loopback backhaul and a P-256
            device key on the host-only p256 crate.
  :mesh_fw  firmware (C6 riscv32imac, P4 riscv32imafc), over :swarm_net_fw.

Firmware-target build check (also in CI):
  bazel build -c opt --platforms=@embedded//platforms:esp32c6 //firmware/mesh/...
  bazel build -c opt --platforms=@embedded//platforms:esp32p4 //firmware/mesh/...
"""

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

SRCS = glob(["src/*.rs"])

rust_library(
    name = "mesh",
    srcs = SRCS,
    crate_features = [
        "custodian_spill",
        "host",
    ],
    crate_name = "splanc_mesh",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//firmware/mesh/swarm:swarm_net",
        "//firmware/netstack",
        "@player_crates//:p256",
    ],
)

rust_test(
    name = "mesh_test",
    size = "small",
    crate = ":mesh",
    data = ["//firmware/mesh/swarm:proto/testdata/swarm_wire_golden.txt"],
    edition = "2021",
    env = {"SWARM_WIRE_GOLDEN": "$(rootpath //firmware/mesh/swarm:proto/testdata/swarm_wire_golden.txt)"},
)

# Open mode (guests, the follow stream) is compiled out until M7b (feature `open_mode`); this
# keeps it building and tested.
rust_test(
    name = "mesh_open_mode_test",
    size = "small",
    srcs = SRCS,
    crate_features = [
        "custodian_spill",
        "host",
        "open_mode",
    ],
    crate_root = "src/lib.rs",
    data = ["//firmware/mesh/swarm:proto/testdata/swarm_wire_golden.txt"],
    edition = "2021",
    env = {"SWARM_WIRE_GOLDEN": "$(rootpath //firmware/mesh/swarm:proto/testdata/swarm_wire_golden.txt)"},
    deps = [
        "//firmware/mesh/swarm:swarm_net",
        "//firmware/netstack",
        "@player_crates//:p256",
    ],
)

rust_library(
    name = "mesh_fw",
    srcs = SRCS,
    crate_name = "splanc_mesh",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//firmware/mesh/swarm:swarm_net_fw",
        "//firmware/netstack",
    ],
)
