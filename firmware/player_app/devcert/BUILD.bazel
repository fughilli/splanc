# Self-signed dev cert for the player's wss endpoint, generated at build time
# (no private key checked in). Bazel caches the genrule output, so the cert is
# stable across incremental builds — the phone accepts it once, not per reflash.
# Replace with per-device on-device generation once mbedtls x509write headers
# are available (the SDK currently prunes them).
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "gen",
    outs = ["dev_cert.h"],
    cmd = """
set -e
# EC P-256 (prime256v1 / secp256r1): the C6 mbedtls config enables ECDSA_C +
# secp256r1 + the ECDHE_ECDSA key exchange, so an ECDSA leaf works and is much
# smaller than RSA (~600 B PEM vs ~1.4 KB) — cheaper to re-issue on-device (see
# main.cpp: reused as the key for the live-IP SAN cert) and lighter on the TLS
# handshake. (The old "EC curves are #undef'd" note was stale — they're on.)
openssl ecparam -name prime256v1 -genkey -noout -out cert_key.pem 2>/dev/null
openssl req -new -x509 -key cert_key.pem -out cert_crt.pem -days 3650 \
    -subj "/CN=ledmapper-player" 2>/dev/null
{
  echo '// Generated by //firmware/player_app/devcert:gen — do not edit.'
  echo '#pragma once'
  echo 'static const char kDevCertPem[] ='
  sed 's/.*/"&\\\\n"/' cert_crt.pem
  echo ';'
  echo 'static const char kDevKeyPem[] ='
  sed 's/.*/"&\\\\n"/' cert_key.pem
  echo ';'
} > $@
""",
)

cc_library(
    name = "dev_cert",
    hdrs = ["dev_cert.h"],
)
