"""Agent-bundle stamps for the discovery manifest (GET /.well-known/splanc.json).

The release pipeline builds the firmware with the agent bundle it publishes:

    --//firmware/player_app:agent_bundle_url=https://.../splanc-agent-1.2.0.tgz
    --//firmware/player_app:agent_bundle_sha256=<hex>

Both default to empty: the device then derives the release URL from its version
(firmware-v<V>/splanc-agent-<V>.tgz) and names no hash, and a dev/dirty build
names no bundle at all (Player::agent_manifest).
"""

load("@bazel_skylib//rules:common_settings.bzl", "BuildSettingInfo")

def _c_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

def _agent_bundle_info_impl(ctx):
    out = ctx.actions.declare_file(ctx.attr.out)
    url = ctx.attr.url[BuildSettingInfo].value
    sha = ctx.attr.sha256[BuildSettingInfo].value
    ctx.actions.write(
        out,
        "\n".join([
            "// Generated by //firmware/player_app:agent_bundle.bzl. Do not edit.",
            "#pragma once",
            "#define LM_AGENT_BUNDLE_URL " + _c_str(url),
            "#define LM_AGENT_BUNDLE_SHA256 " + _c_str(sha),
            "",
        ]),
    )
    return [DefaultInfo(files = depset([out]))]

agent_bundle_info = rule(
    implementation = _agent_bundle_info_impl,
    attrs = {
        "out": attr.string(mandatory = True),
        "sha256": attr.label(mandatory = True, providers = [BuildSettingInfo]),
        "url": attr.label(mandatory = True, providers = [BuildSettingInfo]),
    },
)
