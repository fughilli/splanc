# The app's half of OTA (ota_app.h, docs/design/ota.md): the OTA arms, the handoff to
# the loader, the health check that marks a fresh install valid, the crash-loop guard.
# The decisions are the Rust core (//firmware/ota), whose C ABI rides in :player_ffi.
cc_library(
    name = "ota_app",
    srcs = [
        "ota_app.cpp",
        "serial_log.h",
        ":build_info_h",
    ],
    hdrs = ["ota_app.h"],
    # The SAME mbedtls config the linked from-source mbedtls was built with (as
    # :device_cert): mbedtls_sha256_context's layout depends on it, and a mismatch
    # made the app's slot re-hash come out wrong (app_version 0 on hardware).
    copts = [
        "-fno-rtti",
        "-DMBEDTLS_CONFIG_FILE=\\\"mbedtls/esp_config_ledmapper.h\\\"",
    ],
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "@embedded//platforms:is_esp32c3": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
