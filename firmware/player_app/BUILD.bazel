"""ESP32-C6 player firmware app (bring-up build — see README.md).

WiFi soft-AP + HTTP (landing page) + plain-WS player protocol bridged into
the Rust session core via a C ABI staticlib, RMT WS2812 strip rendering. The
Rust side links the FIRMWARE capacity profile of the generated protobuf
(//shared/protocol/rust:ledmapper_pb_fw); host tests drive the same ffi.rs
against the host profile, and the RFC6455 codec is host-tested byte-exactly.


Requirements (PRs implemented here; see requirements/requirements.yaml): PR-1, PR-7, PR-9, PR-11, PR-12, PR-34, PR-36
"""

load("@embedded//rules:firmware.bzl", "firmware_binary")
load("@embedded//rules:flash.bzl", "esptool_flash")
load("@embedded//rules:resources.bzl", "c_resource_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_static_library", "rust_test")
load("//tools:flash_bundle.bzl", "flash_bundle")
load("//tools/build_info:build_info.bzl", "build_info_file")
load(":led_caps.bzl", "MAX_LEDS")

package(default_visibility = ["//visibility:public"])

# Git build info (FUG-126): main.cpp includes this stamped header and reports the
# commit + dirty flag to the app in every `welcome` (see lm_player_set_build_info).
build_info_file(
    name = "build_info_h",
    out = "build_info.h",
    template = "build_info.h.tmpl",
)

# The board-caps descriptor as a labelable source: the HITL board-caps check
# (//pi/hitl) loads this SAME textproto as its expected value, so the on-hardware
# report is pinned to exactly what the image embeds.
exports_files(["board_caps.textproto"])

# The C ABI over the player stack, as the firmware links it. Bare-metal
# only (it carries the panic handler); the host test drives the same source
# via :player_ffi_host.
rust_static_library(
    name = "player_ffi",
    srcs = ["ffi.rs"],
    crate_name = "ledmapper_player_ffi",
    edition = "2021",
    # LED cap SSOT (led_caps.bzl): ffi.rs FX_TOPO_CAP reads env!("LM_MAX_LEDS").
    rustc_env = {"LM_MAX_LEDS": "%d" % MAX_LEDS},
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//firmware/arena",
        "//firmware/fx_jit",
        "//firmware/fx_vm",
        "//firmware/osc",
        "//firmware/player:player_fw",
        "//firmware/pulse",
        "//firmware/store",
        "//shared/protocol/rust:ledmapper_pb_fw",
        "@crates//:micropb",
    ],
)

# The same ffi.rs against the HOST capacity profile, for the host test (the
# profiles differ only in repeated-field capacities).
rust_library(
    name = "player_ffi_host",
    srcs = ["ffi.rs"],
    crate_name = "ledmapper_player_ffi",
    edition = "2021",
    # LED cap SSOT (led_caps.bzl): ffi.rs FX_TOPO_CAP reads env!("LM_MAX_LEDS").
    rustc_env = {"LM_MAX_LEDS": "%d" % MAX_LEDS},
    deps = [
        "//firmware/arena",
        "//firmware/fx_jit",
        "//firmware/fx_vm",
        "//firmware/osc",
        "//firmware/player",
        "//firmware/pulse",
        "//firmware/store",
        "//shared/protocol/rust:ledmapper_pb",
        "@crates//:micropb",
    ],
)

rust_test(
    name = "ffi_test",
    srcs = ["tests/ffi.rs"],
    edition = "2021",
    env = {
        # Host-profile envelopes carry big inline heapless storage.
        "RUST_MIN_STACK": "16777216",
    },
    deps = [
        ":player_ffi_host",
        "//fx_compiler",
        "//shared/protocol/rust:ledmapper_pb",
        "@crates//:micropb",
    ],
)

# The color-order counting probe must preempt the FX engine with no map stored.
# Own binary (fresh process-global FFI state) so it can arm an effect + skip the
# map without the full-flow test's ordering — see tests/counting_preempt.rs.
rust_test(
    name = "counting_preempt_test",
    srcs = ["tests/counting_preempt.rs"],
    edition = "2021",
    env = {
        # Host-profile envelopes carry big inline heapless storage.
        "RUST_MIN_STACK": "16777216",
    },
    deps = [
        ":player_ffi_host",
        "//fx_compiler",
        "//shared/protocol/rust:ledmapper_pb",
        "@crates//:micropb",
    ],
)

# Transport profile (FUG-121): per-uniform-update device-CPU cost of the proto
# `set_uniforms` path vs native OSC ingest, to decide whether a proto-transport
# bridge is worth keeping. `bazel run //firmware/player_app:transport_bench`.
rust_binary(
    name = "transport_bench",
    srcs = ["bench/transport.rs"],
    edition = "2021",
    deps = [
        ":player_ffi_host",
        "//firmware/fx_vm",
        "//firmware/osc",
        "//fx_compiler",
        "//shared/protocol/rust:ledmapper_pb",
        "@crates//:micropb",
    ],
)

cc_library(
    name = "ws_codec",
    hdrs = ["ws_codec.h"],
)

cc_test(
    name = "ws_codec_test",
    srcs = ["ws_codec_test.cc"],
    deps = [":ws_codec"],
)

cc_library(
    name = "improv_codec",
    hdrs = ["improv_codec.h"],
)

cc_library(
    name = "color_correction",
    hdrs = ["color_correction.h"],
)

cc_test(
    name = "color_correction_test",
    srcs = ["color_correction_test.cc"],
    deps = [":color_correction"],
)

cc_test(
    name = "improv_codec_test",
    srcs = ["improv_codec_test.cc"],
    deps = [":improv_codec"],
)

# Board capability descriptor (FUG-123): the checked-in textproto is compiled to
# a serialized BoardCapabilities at build time by the hermetic protoc, then
# embedded as board_caps_binaryproto[] / board_caps_binaryproto_len via
# c_resource_library (symbols from the file basename). main.cpp hands it to
# lm_set_board_caps at boot; the player echoes it in hardware_config_state.
# Board-specific firmware_binary targets swap in their own textproto here.
genrule(
    name = "board_caps_binaryproto",
    srcs = [
        "board_caps.textproto",
        "//shared/protocol/proto:ledmapper.proto",
    ],
    outs = ["board_caps.binaryproto"],
    cmd = "$(execpath //tools/toolchains:protoc) " +
          "-I $$(dirname $(location //shared/protocol/proto:ledmapper.proto)) " +
          "--encode=ledmapper.v1.BoardCapabilities " +
          "$(location //shared/protocol/proto:ledmapper.proto) " +
          "< $(location board_caps.textproto) > $@",
    tools = ["//tools/toolchains:protoc"],
)

# -> board_caps_binaryproto[] / board_caps_binaryproto_len (symbols from basename).
c_resource_library(
    name = "board_caps_res",
    srcs = [":board_caps_binaryproto"],
)

cc_binary(
    name = "player_app",
    srcs = [
        "improv_ble.cpp",
        "improv_ble.h",
        "led_config.h",
        "main.cpp",
        "player_ffi.h",
        "serial_log.h",
        "ws2812_rmt.cpp",
        "ws2812_rmt.h",
        ":build_info_h",  # generated build_info.h (git commit + dirty flag)
    ],
    # Match the SDK/library ABI: the Arduino tree builds -fno-rtti, and a
    # subclass of its polymorphic types must not demand base typeinfo.
    copts = ["-fno-rtti"],
    # LED cap SSOT (led_caps.bzl): kMaxLeds / NUM_LEDS derive from LM_MAX_LEDS.
    local_defines = ["LM_MAX_LEDS=%d" % MAX_LEDS],
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":board_caps_res",
        ":color_correction",
        ":improv_codec",
        ":player_ffi",
        ":ws_codec",
        "//firmware/landing:landing_page",
        "@embedded//libs/tls:selfsigned",
        # NOT @embedded//libs/pins: it propagates LED_DATA_PIN=8 (the
        # DevKitC-1 onboard LED); our strip wiring lives in led_config.h.
        "@embedded//libs/board:arduino_core",
        "@embedded//libs/vendor:ble",
        "@embedded//libs/vendor:preferences",
        "@embedded//libs/vendor:webserver",
        "@embedded//libs/vendor:wifi",
    ],
)

# opt_mode="opt": the image is unusable unoptimized (fastbuild is far larger and
# slower), so the target pins -c opt via the board transition — no need to pass
# `-c opt` on the command line. tags=manual keeps it OUT of the `//...` wildcard
# so routine `bazel test //...` (incl. dev on a small container) stays light —
# this image compiles mbedtls + the Arduino core FROM SOURCE. CI still builds it,
# explicitly, in the dedicated `firmware` job (.github/workflows/test.yaml).
# Build locally with:
#   bazelisk build -c opt //firmware/player_app:esp32c6
firmware_binary(
    name = "esp32c6",
    binary = ":player_app",
    board = "esp32c6",
    opt_mode = "opt",
    tags = ["manual"],
)

# -- On-device OSC bench image (FUG-121) -------------------------------------
# A dedicated -DLM_OSC_BENCH build that, at boot, times one uniform update via
# each transport with the C6 cycle counter, logs `[oscbench]` lines and halts.
# Read it over HITL: `hitl flash --monitor …:esp32c6_oscbench_flashbundle`.
# tags=manual keeps this heavy image out of the wildcard.
genrule(
    name = "osc_bench_fxb_file",
    srcs = ["bench/osc_bench.fx"],
    outs = ["osc_bench.fxb"],
    cmd = "$(execpath //fx_compiler:fx_compile) $(execpath bench/osc_bench.fx) $(execpath osc_bench.fxb)",
    tools = ["//fx_compiler:fx_compile"],
)

# -> osc_bench_fxb[] / osc_bench_fxb_len (symbols from the file basename).
c_resource_library(
    name = "osc_bench_fxb_res",
    srcs = [":osc_bench_fxb_file"],
)

cc_binary(
    name = "player_app_oscbench",
    srcs = [
        "improv_ble.cpp",
        "improv_ble.h",
        "led_config.h",
        "main.cpp",
        "player_ffi.h",
        "serial_log.h",
        "ws2812_rmt.cpp",
        "ws2812_rmt.h",
        ":build_info_h",  # generated build_info.h (git commit + dirty flag)
    ],
    copts = ["-fno-rtti"],
    local_defines = [
        "LM_OSC_BENCH",
        "LM_MAX_LEDS=%d" % MAX_LEDS,
    ],
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":color_correction",
        ":improv_codec",
        ":osc_bench_fxb_res",
        ":player_ffi",
        ":ws_codec",
        "//firmware/landing:landing_page",
        "@embedded//libs/board:arduino_core",
        "@embedded//libs/tls:selfsigned",
        "@embedded//libs/vendor:ble",
        "@embedded//libs/vendor:preferences",
        "@embedded//libs/vendor:webserver",
        "@embedded//libs/vendor:wifi",
    ],
)

firmware_binary(
    name = "esp32c6_oscbench",
    binary = ":player_app_oscbench",
    board = "esp32c6",
    opt_mode = "opt",
    tags = ["manual"],
)

esptool_flash(
    name = "flash_esp32c6_oscbench",
    app = ":esp32c6_oscbench",
    partitions = "@embedded//libs/vendor:partitions_huge_app",
    tags = ["manual"],
)

flash_bundle(
    name = "esp32c6_oscbench_flashbundle",
    flash = ":flash_esp32c6_oscbench",
    tags = ["manual"],
)

# -- On-device JIT A/B image (FUG-125) ---------------------------------------
# A -DLM_FX_JIT_BENCH build that, at boot, times shade() across the strip with
# the on-device JIT disabled vs enabled (on ONE firmware) and checks the JIT
# renders bit-identically to the interpreter; logs `[fxjitbench]` and halts.
# Read over HITL: `hitl flash --monitor …:esp32c6_fxjitbench_flashbundle`.
genrule(
    name = "jit_bench_fxb_file",
    srcs = ["bench/jit_bench.fx"],
    outs = ["jit_bench.fxb"],
    cmd = "$(execpath //fx_compiler:fx_compile) $(execpath bench/jit_bench.fx) $(execpath jit_bench.fxb)",
    tools = ["//fx_compiler:fx_compile"],
)

# -> jit_bench_fxb[] / jit_bench_fxb_len (symbols from the file basename).
c_resource_library(
    name = "jit_bench_fxb_res",
    srcs = [":jit_bench_fxb_file"],
)

cc_binary(
    name = "player_app_fxjitbench",
    srcs = [
        "improv_ble.cpp",
        "improv_ble.h",
        "led_config.h",
        "main.cpp",
        "player_ffi.h",
        "serial_log.h",
        "ws2812_rmt.cpp",
        "ws2812_rmt.h",
        ":build_info_h",  # generated build_info.h (git commit + dirty flag)
    ],
    copts = ["-fno-rtti"],
    local_defines = [
        "LM_FX_JIT_BENCH",
        "LM_MAX_LEDS=%d" % MAX_LEDS,
    ],
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":color_correction",
        ":improv_codec",
        ":jit_bench_fxb_res",
        ":player_ffi",
        ":ws_codec",
        "//firmware/landing:landing_page",
        "@embedded//libs/board:arduino_core",
        "@embedded//libs/tls:selfsigned",
        "@embedded//libs/vendor:ble",
        "@embedded//libs/vendor:preferences",
        "@embedded//libs/vendor:webserver",
        "@embedded//libs/vendor:wifi",
    ],
)

firmware_binary(
    name = "esp32c6_fxjitbench",
    binary = ":player_app_fxjitbench",
    board = "esp32c6",
    opt_mode = "opt",
    tags = ["manual"],
)

esptool_flash(
    name = "flash_esp32c6_fxjitbench",
    app = ":esp32c6_fxjitbench",
    partitions = "@embedded//libs/vendor:partitions_huge_app",
    tags = ["manual"],
)

flash_bundle(
    name = "esp32c6_fxjitbench_flashbundle",
    flash = ":flash_esp32c6_fxjitbench",
    tags = ["manual"],
)

# The image (~2.05 MB at -c opt: WiFi + BLE + webserver + the RMT driver + the
# protocol stack) exceeds default.csv's 1.25 MB app slot and just misses
# no_ota's 2 MB — flash the 4 MB "huge app" layout (single 3 MB factory
# app + nvs, fits the common 4 MB-flash C6 devkits; a dual-OTA 8 MB table
# would overrun a 4 MB chip and boot-loop).
esptool_flash(
    name = "flash_esp32c6",
    app = ":esp32c6",
    partitions = "@embedded//libs/vendor:partitions_huge_app",
    tags = ["manual"],
)

# A self-describing flash bundle (flash.json manifest + the four bins) built from
# the flash launcher — one artifact the HITL rig flashes in a single step, no
# hand-copied offsets. Consumed by `bazel run //pi/hitl:hitl -- flash …`.
flash_bundle(
    name = "esp32c6_flashbundle",
    flash = ":flash_esp32c6",
    tags = ["manual"],
)
