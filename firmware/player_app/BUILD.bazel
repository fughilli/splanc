package(default_visibility = ["//visibility:public"])

# WS2812 backend (ws2812.h). The C6 drives the strip from PARLIO+GDMA so ISR
# latency can't corrupt a frame on the wire; the C3 has no PARLIO and keeps the
# interrupt-refilled RMT driver. --//firmware/player_app:ws2812_rmt forces RMT on
# the C6 too, for A/B wire captures (//pi/hitl/harness:led_timing).
bool_flag(
    name = "ws2812_rmt",
    build_setting_default = False,
)

config_setting(
    name = "ws2812_rmt_forced",
    flag_values = {":ws2812_rmt": "True"},
)

# Post-boot heap census (heap_census.cpp): attribute every allocation after setup()
# to its call site; //pi/hitl/harness:ram_audit dumps it over JTAG at the end of a
# run (census.md). A diagnostic build (~12 KB of RAM: the 9.8 KB table + ~2.6 KB
# IRAM shims), so off by default: --//firmware/player_app:heap_census_enabled.
bool_flag(
    name = "heap_census_enabled",
    build_setting_default = False,
)

config_setting(
    name = "heap_census_on",
    flag_values = {":heap_census_enabled": "True"},
)

WS2812_SRCS = ["ws2812.h"] + select({
    "@embedded//platforms:is_esp32c3": ["ws2812_rmt.cpp"],
    ":ws2812_rmt_forced": ["ws2812_rmt.cpp"],
    "//conditions:default": ["ws2812_parlio.cpp"],
})

