# -- OTA layout (docs/design/ota.md) ------------------------------------------------
# bootloader 0x0 | table 0x8000 | nvs 0x9000 (kept) | otadata 0xe000 (erased: the
# loader boots first) | loader 0x10000 (1344K) | littlefs 0x160000 (384K) | app
# 0x1c0000 (2304K). From the legacy huge_app layout this is a one-time USB migration
# in two phases (everything below the app first, then the app — the loader copies the
# old littlefs across in between); flash.json's "ota" block tells a flasher how.
OTA_BUNDLE_JSON = json.encode({
    "ota": {
        "layout": "loader-app-v1",
        "app_offset": "0x1c0000",
        "app_slot_size": "0x240000",
        "legacy_migration": {
            # A table without a factory "loader" partition is the legacy layout.
            "detect_table_offset": "0x8000",
            "phase1_below": "0x1c0000",
            "wait_serial": "[loader] migrate: done",
            "wait_seconds": 30,
        },
    },
})

[firmware_binary(
    name = "esp32c6_netstack" + sfx,
    binary = ":player_app_netstack" + sfx,
    board = "esp32c6",
    opt_mode = "opt",
    tags = ["manual"],
) for sfx, _ in NETSTACK_VARIANTS if sfx]

# The shipping OTA-layout bundle (the loader trusts --//firmware/ota:trust, release by
# default). Release CI publishes it as esp32c6-netstack-<ver>.tar plus the signed
# esp32c6-netstack-<ver>.ota (tools/ota_release.sh).
ota_flash(
    name = "flash_esp32c6_ota",
    app = ":esp32c6_netstack",
    loader = "//firmware/loader:esp32c6_loader",
    otadata = "//firmware/loader:otadata_erased",
    partitions = "//firmware/loader:partitions_ota_bin",
    tags = ["manual"],
    tool_from = ":flash_esp32c6_netstack",
)

flash_bundle(
    name = "esp32c6_ota_flashbundle",
    extra_json = OTA_BUNDLE_JSON,
    flash = ":flash_esp32c6_ota",
    tags = ["manual"],
)

# Test-signed .ota packages (manifest || image, signed with the public TEST key) for
# the HITL OTA gate and local development, and a bundle whose loader trusts that key.
OTA_TEST_PACKAGES = [
    ("", "900001"),
    ("_ota_b", "900002"),
    ("_ota_crash", "900003"),
    ("_ota_unhealthy", "900004"),
]

[ota_package(
    name = "esp32c6_netstack%s_testsigned" % sfx,
    app = ":esp32c6_netstack" + sfx,
    manifest_key = "//firmware/ota:keys/test.key",
    tags = ["manual"],
    version = version,
) for sfx, version in OTA_TEST_PACKAGES]

# Key rotation in the HITL gate (docs/design/ota.md "Key rotation"): B signed by the
# TEST backup key (key id 1), and a key-epoch record, signed by that backup key, that
# revokes the test release key (id 0).
ota_package(
    name = "esp32c6_netstack_ota_b_backupsigned",
    app = ":esp32c6_netstack_ota_b",
    key_id = 1,
    manifest_key = "//firmware/ota:keys/test_backup.key",
    tags = ["manual"],
    version = "900005",
)

genrule(
    name = "ota_test_epoch_revoke_release",
    srcs = ["//firmware/ota:keys/test_backup.key"],
    outs = ["ota_test_epoch_revoke_release.bin"],
    cmd = "$(execpath //firmware/ota:ota_sign) epoch --key-file $< --key-id 1 --epoch 1 --revoke 0 --out $@ >/dev/null",
    tags = ["manual"],
    tools = ["//firmware/ota:ota_sign"],
)

ota_flash(
    name = "flash_esp32c6_ota_testkey",
    app = ":esp32c6_netstack",
    loader = "//firmware/loader:esp32c6_loader_testkey",
    otadata = "//firmware/loader:otadata_erased",
    partitions = "//firmware/loader:partitions_ota_bin",
    tags = ["manual"],
    tool_from = ":flash_esp32c6_netstack",
)

flash_bundle(
    name = "esp32c6_ota_testkey_flashbundle",
