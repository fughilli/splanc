# Board capability descriptor (FUG-123): the checked-in textproto is compiled to
# a serialized BoardCapabilities at build time by the hermetic protoc, then
# embedded as board_caps_binaryproto[] / board_caps_binaryproto_len via
# c_resource_library (symbols from the file basename). main.cpp hands it to
# lm_set_board_caps at boot; the player echoes it in hardware_config_state.
# Board-specific firmware_binary targets swap in their own textproto here.
genrule(
    name = "board_caps_binaryproto",
    srcs = [
        "board_caps.textproto",
        "//shared/protocol/proto:ledmapper.proto",
    ],
    outs = ["board_caps.binaryproto"],
    cmd = "$(execpath //tools/toolchains:protoc) " +
          "-I $$(dirname $(location //shared/protocol/proto:ledmapper.proto)) " +
          "--encode=ledmapper.v1.BoardCapabilities " +
          "$(location //shared/protocol/proto:ledmapper.proto) " +
          "< $(location board_caps.textproto) > $@",
    tools = ["//tools/toolchains:protoc"],
)

# -> board_caps_binaryproto[] / board_caps_binaryproto_len (symbols from basename).
c_resource_library(
    name = "board_caps_res",
    srcs = [":board_caps_binaryproto"],
)

# -- Vendor player firmware REMOVED -------------------------------------------
# The vendor-WiFi/BT player build (:player_app cc_binary + :esp32c6 firmware_binary
# + :flash_esp32c6 + :esp32c6_flashbundle) is deprecated and deleted: the heapless
# netstack variant below is the shipping player transport, and the vendor HITL lane
# was retired. The esp32c6 SKU/board lives on (the netstack tests reserve C6 DUTs);
# only the vendor *image* is gone. The :oscbench / :fxjitbench dev images still build
# the vendor stack for one-off benchmarking (tags=manual, not in CI).

# -- Heapless-netstack player variant (esp32c6_netstack) ----------------------
# The same LED Mapper player, but the ENTIRE WiFi transport is ours from the PHY
# blob up (//firmware/netstack): BLE Improv provisioning -> heapless MAC -> WPA2
# 4-way (HW-AES CCMP) -> DHCP -> TCP -> mbedtls TLS 1.2 -> RFC6455 WS ->
# lm_player_handle. No vendor WiFi/lwIP/esp_https_server on the data path. Passes
# the full //pi/hitl/harness:e2e_netstack (BLE provisioning included) on silicon.
# The shipping image is the "" variant. The others exist only for the HITL OTA gate
# (//pi/hitl/harness:ota_gate, docs/design/ota.md "Testing"): a second build that
# reports a different fw_version ("+b", for the A->B upgrade), and two deliberately
# broken apps the loader must recover from — one crashes at boot, one never becomes
# healthy (no render task). Same sources; only main.cpp/ota_app.cpp see the defines.
NETSTACK_VARIANTS = [
    ("", []),
    (
        "_ota_b",
        ["LM_OTA_TEST_B=1"],
    ),
    (
        "_ota_crash",
        ["LM_OTA_FAULT=1"],
    ),
    (
        "_ota_unhealthy",
        ["LM_OTA_FAULT=2"],
    ),
]

[cc_binary(
    name = "player_app_netstack" + sfx,
    # SAME main.cpp as the vendor build, gated by -DLM_NETSTACK: the WiFi/WSS/mDNS/OSC
    # transport is swapped for netstack_transport.cpp (our heapless MAC/WPA2/CCMP/DHCP/
    # TCP/TLS/WS), while the render task, effects+JIT, upload, persistence, perf, hardware
    # config and WS dispatch are shared verbatim.
    srcs = [
        # The heapless BLE Improv backend (drives only the radio controller over native
        # HCI) replaces the Bluedroid improv_ble.cpp — no vendor BLE host stack, so BLE
        # onboarding costs no heap churn and the TLS server survives many reconnects.
        # (The transport itself, BLE Improv included, is :netstack_transport, shared
        # with the OTA loader.)
        "led_config.h",
        "main.cpp",
        "player_ffi.h",
        "sensor_bus.cpp",
        "sensor_bus.h",
        "serial_log.h",
        ":agent_bundle_h",
        ":build_info_h",
    ] + WS2812_SRCS,
    copts = ["-fno-rtti"],
    # Two no_std Rust staticlibs (the netstack's wifi_sta_ffi + our player_ffi) each
    # define the panic handler (rust_begin_unwind)/eh_personality; take the first.
    # The c3 link is now STRICT (no --unresolved-symbols=ignore-all): the two
    # formerly-unported C6 translation units are handled per-chip — the BLE HCI
    # shim maps r_ble_hci_trans_*/r_os_mbuf_* to the C3 controller's un-prefixed
    # libbt.a symbols (improv_ble_netstack.cpp, gated on LM_CHIP_ESP32C3), and the
    # mbedtls HW-ECC port (esp_ecc.c) is dropped for the C3 (no HW ECC peripheral)
    # in favour of the software ECP (@mbedtls_src//:mbedtls_src_esp32c3).
    linkopts = ["-Wl,--allow-multiple-definition"],
    local_defines = [
        "LM_NETSTACK",
        # Sensor core (sensor_bus.cpp): I2C IMU probe at boot + sensor task.
        "LM_SENSORS",
    ] + extra + led_cap_defines() + select({
        # Selects the C3 controller HCI ABI (un-prefixed libbt.a symbols) in
        # improv_ble_netstack.cpp; the C6 keeps the ROM r_-prefixed transport.
        "@embedded//platforms:is_esp32c3": ["LM_CHIP_ESP32C3"],
        "//conditions:default": [],
    }),
    # esp32c3 runtime bring-up: the image links strictly and boots on real c3
    # silicon. The WiFi/netstack DATA PATH is not yet c3-correct — the heapless MAC
    # driver and the CCMP HW-AES register map (firmware/netstack) are C6-coupled
    # (ccmp.rs now routes c3 to a SOFTWARE AES so it is correct-but-unaccelerated,
    # never touching C6 registers), and the vendor WiFi/mbedtls crypto pulled in
    # here is still the C6-headers build. See the PR for the remaining c3 MAC work.
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
