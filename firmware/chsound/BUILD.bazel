"""Channel-sounding research firmware (bench only): raw I/Q TX/RX on the ESP32-C6 modem for
two-C6 ranging. See docs/research/channel-sounding.md and tools/chsound/."""

load("@embedded//rules:firmware.bzl", "firmware_binary")
load("@embedded//rules:flash.bzl", "esptool_flash")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//tools:flash_bundle.bzl", "flash_bundle")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "chsound",
    srcs = ["chsound.cpp"],
    target_compatible_with = select({
        "@embedded//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@embedded//libs/board:arduino_core",
        "@embedded//libs/vendor:wifi",
    ],
)

firmware_binary(
    name = "esp32c6",
    binary = ":chsound",
    board = "esp32c6",
    opt_mode = "opt",
    tags = ["manual"],
)

esptool_flash(
    name = "flash_esp32c6",
    app = ":esp32c6",
    partitions = "@embedded//libs/vendor:partitions_huge_app",
    tags = ["manual"],
)

flash_bundle(
    name = "esp32c6_flashbundle",
    flash = ":flash_esp32c6",
    tags = ["manual"],
)
